#!/usr/bin/env fish
# Search opencode conversations using ripgrep + fzf
# Caches session text to ~/.cache/oc-search/
# Usage: oc-search [query]
#
# Works with the opencode v2 schema (session_v2 / session_message / session_part).
# v1 schema (session / message / part) is no longer read.

set -q OC_SEARCH_DB; and set db "$OC_SEARCH_DB"; or set db ~/.local/share/opencode/opencode.db
set -q OC_SEARCH_CACHE; and set cache_dir "$OC_SEARCH_CACHE"; or set cache_dir ~/.cache/oc-search
set -l cache_version 5

if not test -f "$db"
    echo "Error: No opencode database at $db" >&2
    exit 1
end

for cmd in rg fzf sqlite3
    if not command -q $cmd
        echo "Error: $cmd not installed" >&2
        exit 1
    end
end

if test (sqlite3 "$db" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='session_v2';") -eq 0
    echo "Error: $db has no session_v2 table (not an opencode v2 database)" >&2
    exit 1
end

mkdir -p "$cache_dir"

# -- force cache rebuild if script was updated --
set -l version_file "$cache_dir/.version"
if not test -f "$version_file"; or test (cat "$version_file") -ne $cache_version
    find "$cache_dir" -maxdepth 1 -type f -delete
    echo $cache_version >"$version_file"
end

# --- update cache ---
# Columns are emitted id|updated|title so titles may contain '|' safely.
sqlite3 -separator '|' "$db" "
    SELECT s.id, s.time_updated, coalesce(s.title, 'untitled')
    FROM session_v2 s
    WHERE s.time_archived IS NULL
    ORDER BY s.time_updated DESC
" | while read -l line
    set -l id (echo "$line" | cut -d'|' -f1)
    set -l updated (echo "$line" | cut -d'|' -f2)
    set -l title (echo "$line" | cut -d'|' -f3-)

    set -l safe_title (echo "$title" | string replace -ar '[\/:*?"<>|]' '_' | string shorten -m 80)
    set -l cache_file "$cache_dir"/"$updated"::"$id"::"$safe_title"

    set -l needs_update 1
    if test -f "$cache_file"
        set -l ft (stat -c %Y "$cache_file" 2>/dev/null || echo 0)
        if test "$ft" -ge (math "floor($updated / 1000)")
            set needs_update 0
        end
    end

    if test "$needs_update" -eq 1
        set -l created (sqlite3 "$db" "SELECT datetime(time_created/1000, 'unixepoch', 'localtime') FROM session_v2 WHERE id='$id';")

        # Write header
        printf '# %s\n# %s\n\n' "$title" "$created" > "$cache_file"

        # Write messages.
        # v2 keeps user text in data.text and assistant text parts in data.content[].
        # Synthetic/system/compaction events are harness noise and are skipped,
        # as are supermemory context injections.
        sqlite3 "$db" "
            SELECT
                '## ' ||
                CASE t.type
                    WHEN 'user' THEN 'USER'
                    WHEN 'assistant' THEN 'ASSISTANT'
                    ELSE upper(t.type)
                END ||
                ' (' || datetime(t.time_created/1000, 'unixepoch', 'localtime') || ')' ||
                char(10) || char(10) ||
                t.body || char(10) || char(10)
            FROM (
                SELECT
                    m.seq,
                    m.type,
                    m.time_created,
                    replace(coalesce(
                        json_extract(m.data, '\$.text'),
                        (SELECT group_concat(json_extract(j.value, '\$.text'), char(10) || char(10))
                           FROM json_each(json_extract(m.data, '\$.content')) j
                          WHERE json_extract(j.value, '\$.type') = 'text')
                    ), '**', '') AS body
                FROM session_message m
                WHERE m.session_id = '$id'
                  AND m.type IN ('user', 'assistant')
            ) t
            WHERE t.body IS NOT NULL
              AND trim(t.body) <> ''
              AND NOT (t.type = 'user'
                       AND (t.body LIKE '[SUPERMEMORY]%'
                            OR t.body LIKE '<supermemory-recall>%'))
            ORDER BY t.seq
        " >> "$cache_file"
    end
end

# --- fzf ---
set -l QUERY $argv[1]

rg --files-with-matches --smart-case --no-ignore '' "$cache_dir" 2>/dev/null \
| sed "s|^$cache_dir/||" \
| sort \
| fzf \
    --ansi \
    --query "$QUERY" \
    --prompt '  Search conversations > ' \
    --delimiter '::' \
    --with-nth '3..' \
    --preview "rg --color=always -i -C 3 {q} $cache_dir/{} 2>/dev/null || bat --language=markdown --style=plain --color=always $cache_dir/{} 2>/dev/null || cat $cache_dir/{}" \
    --preview-window 'right:60%:wrap' \
    --header '  ENTER: nvim  |  CTRL-O: open in opencode  |  CTRL-X: delete  |  CTRL-C: exit' \
    --disabled \
    --bind "change:reload(rg --files-with-matches --smart-case --no-ignore {q} $cache_dir 2>/dev/null | sed 's|^$cache_dir/||' | sort || true)" \
    --bind "enter:execute(nvim $cache_dir/{})" \
    --bind 'ctrl-o:become(systemctl --user start supermemory.service 2>/dev/null; opencode -s {2})' \
    --bind "ctrl-x:execute-silent(oc-search-delete {})+reload(rg --files-with-matches --smart-case --no-ignore {q} $cache_dir 2>/dev/null | sed 's|^$cache_dir/||' | sort || true)+transform-header(oc-search-header {})" \
    --bind "focus:transform-header(oc-search-header {})"
