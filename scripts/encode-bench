#!/usr/bin/env python3
"""VMAF/SSIM/PSNR calibration bench for ffmpeg-encode.

Encodes short samples of real files with a baseline (HEVC CQP) and a sweep of
AV1 CQP qualities, scores each against the source with libvmaf, SSIM and PSNR,
and reports size vs quality so you can pick the AV1 quality that matches your
current HEVC output for the biggest size win.

Handles animated WebP sources: those cannot be stream-copied, so the whole clip
is decoded once to a lossless yuv420p reference, and jobs use software decode +
hwupload (the VAAPI decoder cannot ingest WebP's argb/alpha).

VMAF is run with n_subsample (default 5): scoring every frame of a 1080p clip
makes libvmaf buffer the whole stream and peak at several GB of RAM.

Reuses ffmpeg-encode's own command builder, so it measures the exact pipeline
the TUI uses.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
MAIN = os.path.join(HERE, "ffmpeg-encode")


def load_encoder():
    loader = importlib.machinery.SourceFileLoader("ffmpeg_encode", MAIN)
    spec = importlib.util.spec_from_loader("ffmpeg_encode", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def is_webp(path):
    return os.path.splitext(path)[1].lower() == ".webp"


def extract_sample(fe, src, dest, offset, seconds):
    # Animated WebP is a still-image stream: it cannot be stream-copied into
    # Matroska, and it decodes to argb (alpha), which VAAPI cannot ingest.
    # Decode the whole clip once to a frame-exact lossless yuv420p reference
    # (alpha dropped) so VMAF/SSIM/PSNR compare identical frames.
    if is_webp(src):
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error",
               "-i", src, "-an", "-c:v", "ffv1", "-pix_fmt", "yuv420p",
               "-y", dest]
    else:
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error",
               "-ss", str(offset), "-i", src, "-t", str(seconds),
               "-c", "copy", "-y", dest]
    r = run(cmd)
    if r.returncode != 0 or not os.path.exists(dest):
        raise RuntimeError(f"sample extract failed for {src}:\n{r.stderr}")
    return dest


def old_hevc_cqp_cmd(fe, sample, quality, device, out, sw_decode=False):
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error",
           "-vaapi_device", device]
    if sw_decode:
        cmd += ["-i", sample, "-vf", "format=nv12,hwupload"]
    else:
        cmd += ["-hwaccel", fe.HWACCEL, "-hwaccel_output_format", fe.HWACCEL,
                "-i", sample]
    cmd += ["-c:v", "hevc_vaapi", "-b:v", "0", "-qp", str(quality),
            "-c:a", "copy", "-map", "0:v?", "-map", "0:a?", "-y", out]
    return cmd


def new_cmd(fe, sample, codec, quality, device, out, sw_decode=False):
    job = fe.Job(input_path=sample, output_path=out,
                 input_size=os.path.getsize(sample),
                 duration=fe.get_duration(sample))
    return fe._build_ffmpeg_cmd(job, codec, "balanced", quality, device,
                                sw_decode=sw_decode)


def vmaf(encoded, reference, n_threads, n_subsample):
    fd, log = tempfile.mkstemp(suffix=".json")
    os.close(fd)
    try:
        cmd = [
            "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-i", encoded, "-i", reference,
            "-lavfi",
            f"[0:v][1:v]libvmaf=log_fmt=json:log_path={log}:"
            f"n_threads={n_threads}:n_subsample={n_subsample}",
            "-f", "null", "-",
        ]
        r = run(cmd)
        if r.returncode != 0:
            raise RuntimeError(f"vmaf failed:\n{r.stderr}")
        with open(log) as fh:
            data = json.load(fh)
        return float(data["pooled_metrics"]["vmaf"]["mean"])
    finally:
        if os.path.exists(log):
            os.remove(log)


def _metric(encoded, reference, filt, key):
    """Run a VV->V filter (ssim/psnr with stats_file) and return the pooled
    mean from its final summary line (e.g. 'All:0.977' or 'psnr_avg:41.9')."""
    fd, log = tempfile.mkstemp(suffix=f".{filt}")
    os.close(fd)
    try:
        cmd = [
            "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-i", encoded, "-i", reference,
            "-lavfi",
            f"[0:v]format=yuv420p[a];[1:v]format=yuv420p[b];"
            f"[a][b]{filt}=stats_file={log}",
            "-f", "null", "-",
        ]
        r = run(cmd)
        if r.returncode != 0:
            raise RuntimeError(f"{filt} failed:\n{r.stderr}")
        with open(log) as fh:
            last = [ln for ln in fh if ln.strip()][-1]
        for tok in last.split():
            k, _, v = tok.partition(":")
            if k == key:
                return float(v)
        raise RuntimeError(f"{key} not found in {filt} log: {last!r}")
    finally:
        if os.path.exists(log):
            os.remove(log)


def ssim(encoded, reference):
    return _metric(encoded, reference, "ssim", "All")


def psnr(encoded, reference):
    return _metric(encoded, reference, "psnr", "psnr_avg")


def fmt_size(n):
    return f"{n/1e6:8.2f} MB"


def bench_file(fe, src, args, device, tmp):
    name = os.path.basename(src)
    sample = os.path.join(tmp, f"sample_{os.getpid()}.mkv")
    extract_sample(fe, src, sample, args.offset, args.seconds)
    # WebP decodes to argb (alpha), which the VAAPI decoder cannot ingest; the
    # GPU still encodes, so force software decode + hwupload for these jobs.
    sw = is_webp(src)
    # For WebP the reference is a lossless re-decode, so report the real source
    # size rather than the (much larger) intermediate.
    src_size = os.path.getsize(src) if sw else os.path.getsize(sample)

    results = []  # (label, codec, quality, size, vmaf, ssim, psnr)

    def measure(label, codec, quality, cmd, out):
        r = run(cmd)
        if r.returncode != 0 or not os.path.exists(out):
            print(f"  !! {label} failed: {r.stderr.strip()[:300]}")
            return
        size = os.path.getsize(out)
        score = vmaf(out, sample, args.threads, args.n_subsample)
        s = ssim(out, sample)
        p = psnr(out, sample)
        results.append((label, codec, quality, size, score, s, p))
        if not args.keep:
            os.remove(out)
        print(f"  {label:22s} {fmt_size(size)}  vmaf {score:6.2f}  "
              f"ssim {s:.5f}  psnr {p:6.2f}")

    kind = ("webp (full clip, decoded reference)" if sw
            else f"sample {args.seconds}s @ {args.offset}s")
    print(f"\n=== {name}  ({kind}, {src_size/1e6:.1f} MB) ===")
    print("  encoding baseline + candidates...")
    out = os.path.join(tmp, "base.mkv")
    measure(f"HEVC CQP q{args.hevc_quality}", "hevc-cqp", args.hevc_quality,
            old_hevc_cqp_cmd(fe, sample, args.hevc_quality, device, out, sw),
            out)
    for q in args.hevc_values:
        out = os.path.join(tmp, f"hq_{q}.mkv")
        measure(f"HEVC CQP q{q}", "hevc", q,
                new_cmd(fe, sample, "hevc", q, device, out, sw), out)
    for q in args.av1_values:
        out = os.path.join(tmp, f"av1_{q}.mkv")
        measure(f"AV1 CQP q{q}", "av1", q,
                new_cmd(fe, sample, "av1", q, device, out, sw), out)

    if not results:
        print("  no successful encodes")
        return
    baseline = next((r for r in results if r[1] == "hevc-cqp"), None)
    print(f"\n  {'setting':22s} {'size':>10s} {'vs base':>8s} "
          f"{'vmaf':>7s} {'ssim':>8s} {'psnr':>7s}")
    for label, codec, q, size, score, s, p in results:
        dsize = f"{size/baseline[3]*100:6.1f}%" if baseline else "   -  "
        print(f"  {label:22s} {fmt_size(size)} {dsize:>8s} "
              f"{score:7.2f} {s:8.5f} {p:7.2f}")

    if baseline:
        tol = args.tolerance
        av1 = [r for r in results if r[1] == "av1"]
        ok = [r for r in av1 if r[4] >= baseline[4] - tol]
        if ok:
            best = min(ok, key=lambda r: r[3])
            saving = (1 - best[3] / baseline[3]) * 100
            print(f"\n  -> smallest AV1 within {tol:g} VMAF of baseline: "
                  f"q{best[2]}  ({best[3]/1e6:.1f} MB, "
                  f"{saving:.1f}% smaller than HEVC CQP q{args.hevc_quality}, "
                  f"vmaf {best[4]:.2f})")
        elif av1:
            best = max(av1, key=lambda r: r[4])
            print(f"\n  -> no AV1 setting matched baseline VMAF "
                  f"({baseline[4]:.2f}); best was q{best[2]} at {best[4]:.2f}. "
                  f"Try lower --av1-values.")


def main():
    ap = argparse.ArgumentParser(description="VMAF calibration for ffmpeg-encode")
    ap.add_argument("files", nargs="+", help="source files to sample")
    ap.add_argument("-t", "--seconds", type=float, default=30.0,
                    help="sample length (default: 30)")
    ap.add_argument("-s", "--offset", type=float, default=5.0,
                    help="sample start offset (default: 5)")
    ap.add_argument("--hevc-quality", type=int, default=27,
                    help="HEVC baseline CQP quality (default: 27)")
    ap.add_argument("--hevc-values", type=int, nargs="+", default=[],
                    help="extra HEVC -qp values to sweep (optional)")
    ap.add_argument("--av1-values", type=int, nargs="+",
                    default=[90, 95, 97, 100, 105],
                    help="AV1 CQP -global_quality values to sweep")
    ap.add_argument("--tolerance", type=float, default=0.5,
                    help="allowed VMAF drop vs baseline (default: 0.5)")
    ap.add_argument("--threads", type=int, default=max(1, (os.cpu_count() or 4) // 2),
                    help="libvmaf threads")
    ap.add_argument("--n-subsample", type=int, default=5,
                    help="score every Nth frame (default: 5; keeps libvmaf RAM low)")
    ap.add_argument("--keep", action="store_true", help="keep encoded samples")
    args = ap.parse_args()

    fe = load_encoder()
    device = fe.find_vaapi_device()
    if not device:
        print("error: no VAAPI device found", file=sys.stderr)
        sys.exit(1)

    tmp = tempfile.mkdtemp(prefix="encode-bench-")
    try:
        for src in args.files:
            if not os.path.exists(src):
                print(f"skip (missing): {src}", file=sys.stderr)
                continue
            bench_file(fe, src, args, device, tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    main()
