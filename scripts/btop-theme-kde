#!/usr/bin/env bash
# btop-theme-kde: regenerate a btop theme from the active KDE Plasma color scheme.
# Writes ~/.config/btop/themes/<scheme>.theme and points color_theme at it.
# Safe to run repeatedly (idempotent, no-op when nothing changed).
set -euo pipefail

KDE_CONFIG="${KDE_CONFIG:-$HOME/.config/kdeglobals}"
THEMES_DIR="${BTOP_THEMES_DIR:-$HOME/.config/btop/themes}"
BTOP_CONF="${BTOP_CONF:-$HOME/.config/btop/btop.conf}"

scheme=""
if [ -f "$KDE_CONFIG" ]; then
  scheme="$(awk '/^\[General\]/{f=1} f && /^ColorScheme=/{sub(/^ColorScheme=/,"");gsub(/[[:space:]]/,"");print;exit}' "$KDE_CONFIG")"
fi
[ -n "$scheme" ] || { echo "btop-theme-kde: no active KDE color scheme found" >&2; exit 1; }

# Locate the scheme file; fall back to kdeglobals which holds the active Colors: sections.
colors_file=""
for dir in "$HOME/.local/share/color-schemes" /usr/share/color-schemes; do
  [ -f "$dir/$scheme.colors" ] && colors_file="$dir/$scheme.colors" && break
done
[ -n "$colors_file" ] || colors_file="$KDE_CONFIG"

# get_color SECTION KEY  -> echoes "R G B"
get_color() {
  awk -v s="$1" -v k="$2" '
    $0=="[" s "]" {f=1; next}
    /^\[/ && f {exit}
    f && index($0, k "=")==1 {
      sub(/^[^=]*=/,""); gsub(/[[:space:]]/,"")
      n=split($0,a,","); if (n<3) next
      printf "%s %s %s", a[1], a[2], a[3]; exit
    }' "$colors_file"
}

# mix "R G B" "R G B" FRACTION -> echoes blended "R G B"
mix() {
  awk -v a="$1" -v b="$2" -v f="$3" 'BEGIN{
    split(a,aa," "); split(b,bb," ")
    printf "%d %d %d", aa[1]+(bb[1]-aa[1])*f, aa[2]+(bb[2]-aa[2])*f, aa[3]+(bb[3]-aa[3])*f}'
}

# hex "R G B" -> echoes #rrggbb (values clamped to 0-255)
hex() {
  awk -v c="$1" 'BEGIN{
    split(c,a," ")
    for(i=1;i<=3;i++){ if(a[i]<0)a[i]=0; if(a[i]>255)a[i]=255 }
    printf "#%02x%02x%02x", a[1], a[2], a[3]}'
}

main_bg="$(get_color "Colors:View" BackgroundNormal)"
main_fg="$(get_color "Colors:View" ForegroundNormal)"
accent="$(get_color "Colors:Window" ForegroundActive)"
inact="$(get_color "Colors:View" ForegroundInactive)"
[ -n "$main_bg" ] && [ -n "$main_fg" ] && [ -n "$accent" ] || {
  echo "btop-theme-kde: could not parse colors from $colors_file" >&2; exit 1; }

sel_bg="$(get_color "Colors:Selection" BackgroundNormal)"
sel_fg="$(get_color "Colors:Selection" ForegroundNormal)"
[ -n "$sel_bg" ] && [ -n "$sel_fg" ] || { sel_bg="$accent"; sel_fg="$main_bg"; }

# Semantic meter colors (fall back to accent when absent)
temp_c="$(get_color "Colors:View" ForegroundNegative)";   [ -n "$temp_c" ] || temp_c="$accent"
pos_c="$(get_color "Colors:View" ForegroundPositive)";    [ -n "$pos_c" ] || pos_c="$accent"
neut_c="$(get_color "Colors:View" ForegroundNeutral)";    [ -n "$neut_c" ] || neut_c="$accent"
border="$(mix "$main_bg" "$main_fg" 0.3)"

# shade BASE PART  -> dimmed (toward bg) or lightened (toward fg) version of BASE
shade() { mix "$1" "$main_bg" 0.55; }
light() { mix "$1" "$main_fg" 0.5; }

gen_theme() {
  local out="$1"
  {
    echo "# Auto-generated by btop-theme-kde from KDE scheme \"$scheme\""
    echo "# Regenerated on login or whenever the Plasma color scheme changes."
    echo
    echo "theme[main_bg]=\"$(hex "$main_bg")\""
    echo "theme[main_fg]=\"$(hex "$main_fg")\""
    echo "theme[title]=\"$(hex "$accent")\""
    echo "theme[hi_fg]=\"$(hex "$accent")\""
    echo "theme[selected_bg]=\"$(hex "$sel_bg")\""
    echo "theme[selected_fg]=\"$(hex "$sel_fg")\""
    echo "theme[inactive_fg]=\"$(hex "$inact")\""
    echo "theme[proc_misc]=\"$(hex "$accent")\""
    echo "theme[cpu_box]=\"$(hex "$border")\""
    echo "theme[mem_box]=\"$(hex "$border")\""
    echo "theme[net_box]=\"$(hex "$border")\""
    echo "theme[proc_box]=\"$(hex "$border")\""
    echo "theme[div_line]=\"$(hex "$border")\""
    for m in temp cpu free cached available used download upload; do :; done
    echo "theme[temp_start]=\"$(hex "$(shade "$temp_c")")\""
    echo "theme[temp_mid]=\"$(hex "$temp_c")\""
    echo "theme[temp_end]=\"$(hex "$(light "$temp_c")")\""
    echo "theme[cpu_start]=\"$(hex "$(shade "$accent")")\""
    echo "theme[cpu_mid]=\"$(hex "$accent")\""
    echo "theme[cpu_end]=\"$(hex "$(light "$accent")")\""
    echo "theme[free_start]=\"$(hex "$(shade "$pos_c")")\""
    echo "theme[free_mid]=\"$(hex "$pos_c")\""
    echo "theme[free_end]=\"$(hex "$(light "$pos_c")")\""
    echo "theme[cached_start]=\"$(hex "$(shade "$neut_c")")\""
    echo "theme[cached_mid]=\"$(hex "$neut_c")\""
    echo "theme[cached_end]=\"$(hex "$(light "$neut_c")")\""
    echo "theme[available_start]=\"$(hex "$(shade "$pos_c")")\""
    echo "theme[available_mid]=\"$(hex "$pos_c")\""
    echo "theme[available_end]=\"$(hex "$(light "$pos_c")")\""
    echo "theme[used_start]=\"$(hex "$(shade "$accent")")\""
    echo "theme[used_mid]=\"$(hex "$accent")\""
    echo "theme[used_end]=\"$(hex "$(light "$accent")")\""
    echo "theme[download_start]=\"$(hex "$(shade "$accent")")\""
    echo "theme[download_mid]=\"$(hex "$accent")\""
    echo "theme[download_end]=\"$(hex "$(light "$accent")")\""
    echo "theme[upload_start]=\"$(hex "$(shade "$temp_c")")\""
    echo "theme[upload_mid]=\"$(hex "$temp_c")\""
    echo "theme[upload_end]=\"$(hex "$(light "$temp_c")")\""
  } > "$out"
}

mkdir -p "$THEMES_DIR"
theme_file="$THEMES_DIR/$scheme.theme"
tmp="$theme_file.tmp.$$"
gen_theme "$tmp"

changed=false
if [ ! -f "$theme_file" ] || ! cmp -s "$tmp" "$theme_file"; then
  mv -f "$tmp" "$theme_file"
  changed=true
else
  rm -f "$tmp"
fi

if [ -f "$BTOP_CONF" ]; then
  if ! grep -q "^color_theme = \"$scheme\"" "$BTOP_CONF"; then
    if grep -q "^color_theme" "$BTOP_CONF"; then
      sed -i "s|^color_theme = .*|color_theme = \"$scheme\"|" "$BTOP_CONF"
    else
      echo "color_theme = \"$scheme\"" >> "$BTOP_CONF"
    fi
    changed=true
  fi
fi

if [ "$changed" = true ]; then
  echo "btop-theme-kde: generated $theme_file (color_theme=$scheme)"
else
  echo "btop-theme-kde: up to date"
fi
