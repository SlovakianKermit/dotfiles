#!/usr/bin/env bash
# anker-launcher — run the AnkerGames launcher with WebKit's GPU paths enabled.
#
# The upstream AppImage forces software rendering for every Linux user: at
# startup it sets WEBKIT_DISABLE_DMABUF_RENDERER=1 and
# WEBKIT_SKIA_GPU_PAINTING_THREADS=0, but only when those variables are unset.
# With them set, WebKit rasterises and presents every frame on the CPU in the
# GTK UI process, so scrolling costs time proportional to the window area: at
# 2560x1440 the launcher is unusable, and it re-allocates a wl_shm pool for
# every frame it paints. Setting the two variables to GPU values before exec
# is enough — the launcher honours what it finds — and drops UI-process CPU on
# a 1280x800 window from ~14% to ~3% while scrolling.
#
# Set ANKER_SOFTWARE_RENDER=1 to reproduce upstream behaviour (e.g. if a
# future driver makes the GPU path show a blank window).
set -euo pipefail

APPIMAGE_ROOT="/opt/anker-launcher-bin"

if [[ "${ANKER_SOFTWARE_RENDER:-0}" != "1" ]]; then
	# Only fill these in if the caller did not pick a value already.
	export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-0}"
	export WEBKIT_SKIA_GPU_PAINTING_THREADS="${WEBKIT_SKIA_GPU_PAINTING_THREADS:-4}"
fi

exec "$APPIMAGE_ROOT/AppRun" "$@"
