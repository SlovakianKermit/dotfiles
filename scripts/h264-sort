#!/usr/bin/env bash
# h264-sort — move H.264/AVC videos in a directory into an "h.264" subdirectory.
#
# Codec detection uses ffprobe, but at most once per model: captures from the
# same model always share a codec, so a single file is probed and the result is
# cached in ~/.cache/h264-sort/codecs.tsv for later runs. Parsing a TS over the
# network mount costs ~1s per file, so this turns an O(files) scan into
# O(models), once.
set -euo pipefail

CODEC="h264"
TARGET=""
RECURSE=0
DRY=0
REFRESH=0
JOBS=""
declare -a args=()

EXTS=(mkv mp4 mov m4v avi ts mts m2ts webm flv wmv mpg mpeg ogv 3gp)
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/h264-sort"
CACHE="$CACHE_DIR/codecs.tsv"

die() { printf 'h264-sort: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: h264-sort [OPTIONS] DIR|FILE...

Move every H.264/AVC video found in each directory into a subdirectory of that
directory (default: h.264). Detection is by ffprobe on the first video stream,
not by file extension, and only one file per model is probed: all captures of a
model share a codec. Results are cached in ~/.cache/h264-sort/codecs.tsv.

Options:
  -c, --codec CODEC   ffprobe codec_name to collect (default: h264)
  -t, --target NAME   Subdirectory name (default: h.264, or CODEC if -c given)
  -r, --recursive     Also search subdirectories (target dir itself is skipped)
  -j, --jobs N        Probe N models in parallel (default: 4)
  -R, --refresh       Re-probe every model, ignoring the cache
  -n, --dry-run       Print what would be moved, change nothing
  -h, --help          Show this help and exit

A model is the filename prefix before the _YYYY-MM-DD_HH-MM-SS_mmm timestamp.
Existing files are never overwritten: a numeric suffix is added instead.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--codec)     [[ $# -ge 2 ]] || die "-c needs an argument"; CODEC="$2"; shift 2 ;;
    -t|--target)    [[ $# -ge 2 ]] || die "-t needs an argument"; TARGET="$2"; shift 2 ;;
    -j|--jobs)      [[ $# -ge 2 ]] || die "-j needs an argument"; JOBS="$2"; shift 2 ;;
    -r|--recursive) RECURSE=1; shift ;;
    -R|--refresh)   REFRESH=1; shift ;;
    -n|--dry-run)   DRY=1; shift ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
    -*)             usage >&2; die "unknown option: $1" ;;
    *)              args+=("$1"); shift ;;
  esac
done

[[ ${#args[@]} -gt 0 ]] || { usage >&2; exit 2; }
command -v ffprobe >/dev/null 2>&1 || die "ffprobe not found"

JOBS="${JOBS:-4}"
[[ "$JOBS" =~ ^[0-9]+$ && "$JOBS" -ge 1 ]] || die "-j needs a positive number"

# Default target name: "h.264" for H.264, otherwise the codec name itself.
if [[ -z "$TARGET" ]]; then
  if [[ "$CODEC" == "h264" ]]; then TARGET="h.264"; else TARGET="$CODEC"; fi
fi

# Model key: filename prefix before the capture timestamp. Both "__" and "_"
# separators occur (maye_wells__..., nikoru_sp_...), and model names themselves
# contain underscores, so match the timestamp instead of splitting on "_".
model_key() {
  local b="${1##*/}"
  b="${b%.*}"
  if [[ "$b" =~ ^(.*[^_])_+[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}_[0-9]{3}$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$1"
  fi
}

# find(1) expression matching our extensions, built once.
declare -a ext_expr=()
for e in "${EXTS[@]}"; do
  [[ ${#ext_expr[@]} -gt 0 ]] && ext_expr+=(-o)
  ext_expr+=(-iname "*.$e")
done

# Build the candidate file list.
declare -a files=()
for a in "${args[@]}"; do
  if [[ -d "$a" ]]; then
    if [[ $RECURSE -eq 1 ]]; then
      while IFS= read -r -d '' p; do files+=("$p"); done < <(
        find "$a" -mindepth 1 \
          \( -type d -name "$TARGET" -prune \) -o \
          -type f \( "${ext_expr[@]}" \) -print0
      )
    else
      while IFS= read -r -d '' p; do files+=("$p"); done < <(
        find "$a" -mindepth 1 -maxdepth 1 -type f \( "${ext_expr[@]}" \) -print0
      )
    fi
  elif [[ -f "$a" ]]; then
    files+=("$a")
  else
    printf 'h264-sort: skipping (not found): %s\n' "$a" >&2
  fi
done

[[ ${#files[@]} -gt 0 ]] || { printf 'h264-sort: no video files found\n'; exit 0; }

# Load the model -> codec cache (always: it is rewritten on exit, so entries for
# models not scanned this run must survive a --refresh).
declare -A codec_of=()
if [[ -r "$CACHE" ]]; then
  while IFS=$'\t' read -r k v; do
    [[ -n "$k" && -n "$v" ]] && codec_of["$k"]="$v"
  done <"$CACHE"
fi

CACHE_DIRTY=0
save_cache() {
  [[ $CACHE_DIRTY -eq 1 ]] || return 0
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
  local tmp="$CACHE.$$"
  for k in "${!codec_of[@]}"; do printf '%s\t%s\n' "$k" "${codec_of[$k]}"; done \
    | sort >"$tmp" 2>/dev/null && mv -f "$tmp" "$CACHE" || rm -f "$tmp"
}
trap save_cache EXIT

# Map every file to its model and pick one representative per unprobed model.
declare -A key_of=()
declare -A probe_file=()
hits=0
for f in "${files[@]}"; do
  k="$(model_key "$f")"
  key_of["$f"]="$k"
  if [[ $REFRESH -eq 0 && -n "${codec_of[$k]:-}" ]]; then
    hits=$((hits+1))
  elif [[ -z "${probe_file[$k]:-}" ]]; then
    probe_file["$k"]="$f"
  fi
done

# Probe the representatives, in parallel. \x1f separates key from path.
probed=0
if [[ ${#probe_file[@]} -gt 0 ]]; then
  worker="$(mktemp)"
  out="$(mktemp)"
  cat >"$worker" <<'W'
line=$1
k=${line%%$'\x1f'*}
f=${line#*$'\x1f'}
c=$(ffprobe -v error -select_streams v:0 \
      -show_entries stream=codec_name -of default=nw=1:nk=1 \
      -- "$f" 2>/dev/null | head -n1)
printf '%s\t%s\n' "$k" "${c:-}"
W
  for k in "${!probe_file[@]}"; do printf '%s\x1f%s\n' "$k" "${probe_file[$k]}"; done \
    | xargs -d '\n' -P "$JOBS" -n1 bash "$worker" >"$out" 2>/dev/null || true
  while IFS=$'\t' read -r k v; do
    [[ -n "$k" && -n "$v" ]] || continue
    codec_of["$k"]="$v"
    CACHE_DIRTY=1
    probed=$((probed+1))
  done <"$out"
  rm -f "$worker" "$out"
fi

moved=0; skipped=0; failed=0
for f in "${files[@]}"; do
  if [[ "${codec_of[${key_of[$f]}]:-}" != "$CODEC" ]]; then
    skipped=$((skipped+1)); continue
  fi

  dir="$(dirname "$f")"
  destdir="$dir/$TARGET"
  dest="$destdir/$(basename "$f")"

  if [[ -e "$dest" ]]; then
    stem="${f##*/}"; stem="${stem%.*}"; ext="${f##*/}"; ext="${ext##*.}"
    n=1
    while [[ -e "$destdir/$stem.$n.$ext" ]]; do n=$((n+1)); done
    dest="$destdir/$stem.$n.$ext"
  fi

  if [[ $DRY -eq 1 ]]; then
    printf 'would move: %s -> %s\n' "$f" "$dest"
    moved=$((moved+1)); continue
  fi

  if [[ ! -d "$destdir" ]]; then
    mkdir -p "$destdir" || { printf 'FAILED (mkdir): %s\n' "$destdir" >&2; failed=$((failed+1)); continue; }
  fi

  if mv -f -- "$f" "$dest"; then
    printf 'moved: %s -> %s\n' "$f" "$dest"
    moved=$((moved+1))
  else
    printf 'FAILED: %s\n' "$f" >&2
    failed=$((failed+1))
  fi
done

if [[ $DRY -eq 1 ]]; then verb="to move"; else verb=moved; fi
printf '\nh264-sort: %d %s, %d not %s, %d failed (%d models probed, %d files matched cache)\n' \
  "$moved" "$verb" "$skipped" "$CODEC" "$failed" "$probed" "$hits"
[[ $failed -eq 0 ]]
