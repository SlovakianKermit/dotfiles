#!/usr/bin/env bash
# Sync KDE's trashrc "Empty" flag with the real state of the trash.
#
# Workaround for KDE bug 293651: when a non-KDE app (e.g. LosslessCut via
# GIO/Electron) moves files to a volume trash, KDE never updates
# ~/.config/trashrc [Status] Empty, so Dolphin's "Empty Trash" action stays
# greyed out even though the trash is not empty.
#
# Invoked by shared-trash-sync.path whenever a watched trash changes, and by
# shared-trash-sync.timer periodically as a safety net (path units stop
# working if their watched mount is unmounted and remounted).
#
# The flag is only rewritten when it actually changes, so the periodic timer
# does not churn ~/.config/trashrc.

set -euo pipefail

TRASH_DIRS=(
    "$HOME/.local/share/Trash"
    "/mnt/shared/.Trash-1000"
)

shopt -s nullglob

empty=true
for dir in "${TRASH_DIRS[@]}"; do
    [[ -d "$dir/info" ]] || continue
    entries=("$dir"/info/*.trashinfo)
    if (( ${#entries[@]} > 0 )); then
        empty=false
        break
    fi
done

current="$(kreadconfig6 --file trashrc --group Status --key Empty 2>/dev/null || true)"
[[ "$current" == "$empty" ]] && exit 0

kwriteconfig6 --file trashrc --group Status --key Empty --type bool "$empty"
