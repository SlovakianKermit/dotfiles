#!/usr/bin/env python3
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from collections import deque
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime

FILENAME_RE = re.compile(r'^(.+)_(\d{4}-\d{2}-\d{2})_(\d{2})-(\d{2})-(\d{2})_(\d{3})\.ts$')
FLAT_RE = re.compile(r'^(.+)_Chaturbate_(\d{8})-(\d{6})\.mts$')

VKEY = ("codec_name", "width", "height")
AKEY = ("codec_name", "sample_rate", "channels")

APPEND_MARGIN = 0.5
FREE_MARGIN_BYTES = 1000 * 1000 * 1000

CURRENT_PART = None
CURRENT_APPEND = None
CURRENT_APPEND_SIZE = 0
DELETED_SO_FAR = 0
KEPT_SO_FAR = 0


def parse_filename(name):
    m = FILENAME_RE.match(name)
    if m:
        start = datetime.strptime(
            f"{m.group(2)} {m.group(3)}:{m.group(4)}:{m.group(5)}.{m.group(6)}",
            "%Y-%m-%d %H:%M:%S.%f",
        )
        return m.group(1), start.timestamp()
    m = FLAT_RE.match(name)
    if m:
        start = datetime.strptime(f"{m.group(2)}-{m.group(3)}", "%Y%m%d-%H%M%S")
        return m.group(1), start.timestamp()
    return None


def probe_header(path):
    cmd = [
        "ffprobe", "-v", "error",
        "-read_intervals", "0%+1",
        "-show_entries", "format=start_time",
        "-show_entries", "stream=codec_type,codec_name,width,height,r_frame_rate,sample_rate,channels,id",
        "-of", "json", path,
    ]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        start = float(json.loads(r.stdout)["format"]["start_time"])
    except (KeyError, ValueError, TypeError):
        return None
    v = a = None
    pids = []
    for s in json.loads(r.stdout).get("streams", []):
        if s.get("codec_type") == "video" and v is None:
            v = s
        elif s.get("codec_type") == "audio" and a is None:
            a = s
        if s.get("id") is not None:
            pids.append(str(s["id"]))
    vsig = tuple(v.get(k) for k in VKEY) if v else None
    asig = tuple(a.get(k) for k in AKEY) if a else None
    return start, vsig, asig, tuple(sorted(pids))


def probe_duration(path):
    cmd = [
        "ffprobe", "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=nw=1:nk=1", path,
    ]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return float(r.stdout.strip())
    except ValueError:
        return None


def ts_packet_size(path):
    try:
        with open(path, "rb") as f:
            head = f.read(512)
    except OSError:
        return None
    if len(head) >= 389 and head[0] == 0x47 and head[188] == 0x47 and head[376] == 0x47:
        return 188
    if len(head) >= 389 and head[4] == 0x47 and head[196] == 0x47 and head[388] == 0x47:
        return 192
    return None


def active_write_paths(root):
    # Returns a set of (st_dev, st_ino) keys for recordings open for writing.
    # Matching is by inode rather than by path: the recorders may run in a
    # different mount namespace (e.g. an LXC container) and see the same files
    # under a different path, so a prefix match against "root" would miss them.
    try:
        root_dev = os.stat(root).st_dev
    except OSError:
        return None
    active = set()
    try:
        pids = os.listdir("/proc")
    except OSError:
        return None
    for pid in pids:
        if not pid.isdigit():
            continue
        fddir = f"/proc/{pid}/fd"
        try:
            fds = os.listdir(fddir)
        except OSError:
            continue
        for fd in fds:
            fdpath = os.path.join(fddir, fd)
            try:
                target = os.readlink(fdpath)
            except OSError:
                continue
            if not (target.endswith(".ts") or target.endswith(".mts")):
                continue
            try:
                st = os.stat(fdpath)
            except OSError:
                continue
            if st.st_dev != root_dev:
                continue
            try:
                with open(f"/proc/{pid}/fdinfo/{fd}") as fi:
                    flags = None
                    for line in fi:
                        if line.startswith("flags:"):
                            flags = int(line.split()[1], 8)
                            break
            except (OSError, ValueError):
                continue
            if flags is not None and (flags & 0o3) in (1, 2):
                active.add((st.st_dev, st.st_ino))
    return active


def psi_full_total():
    """Cumulative microseconds of full io stall, or None.

    The counter is used instead of ``avg10``.  ``avg10`` is a decaying average,
    so it reads 0 the instant a burst pauses -- exactly the moment the kernel
    still has hundreds of megabytes of dirty pages to flush.  Dividing the
    counter's delta by the elapsed time gives the true stall percentage over
    the sample window with no smoothing and no aliasing.
    """
    try:
        with open("/proc/pressure/io") as f:
            for line in f:
                if line.startswith("full"):
                    for tok in line.split():
                        if tok.startswith("total="):
                            return int(tok.split("=", 1)[1])
    except (OSError, ValueError):
        return None
    return None


def meminfo_unflushed():
    """Bytes the kernel still owes the disk (Dirty + Writeback)."""
    vals = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                key, _, rest = line.partition(":")
                if key in ("Dirty", "Writeback"):
                    vals[key] = int(rest.split()[0]) * 1024
    except (OSError, ValueError, IndexError):
        return None
    if not vals:
        return None
    return vals.get("Dirty", 0) + vals.get("Writeback", 0)


def diskstats_io(targets):
    """(busy_ms, weighted_ms) for the device(s), straight from the kernel.

    ``busy_ms`` is time with at least one request in flight -- on a slow,
    seek-penalised drive this pins at 100% as soon as anything is queued, so it
    says "the drive is working", not "the drive is overloaded".  ``weighted_ms``
    is the same clock weighted by queue depth, so its delta over the sample
    period is the average queue length: the one number that distinguishes
    "busy" from "backed up".
    """
    want = {f"{maj}:{mino}" for maj, mino in targets}
    if not want:
        return None, None
    busy = weighted = None
    try:
        with open("/proc/diskstats") as f:
            for line in f:
                parts = line.split()
                if len(parts) < 14 or f"{parts[0]}:{parts[1]}" not in want:
                    continue
                try:
                    b, w = int(parts[12]), int(parts[13])
                except ValueError:
                    continue
                busy = b if busy is None else max(busy, b)
                weighted = w if weighted is None else max(weighted, w)
    except OSError:
        return None, None
    return busy, weighted


def device_targets(path):
    """(major, minor) of the disk backing path, whole disk first.

    Whole-disk statistics are preferred so a sibling partition or an unrelated
    writer on the same spindle still shows up as busy.
    """
    dev = backing_device(path)
    if not dev:
        return []
    try:
        st = os.stat(dev)
    except OSError:
        return []
    maj, mino = os.major(st.st_rdev), os.minor(st.st_rdev)
    targets = [(maj, mino)]
    try:
        parent = os.path.dirname(os.path.realpath(f"/sys/dev/block/{maj}:{mino}"))
        with open(os.path.join(parent, "dev")) as f:
            pmaj, pmino = (int(x) for x in f.read().strip().split(":"))
        if (pmaj, pmino) != targets[0]:
            targets.insert(0, (pmaj, pmino))
    except (OSError, ValueError):
        pass
    return targets


class DiskSampler:
    """Measures how loaded the backing disk actually is.

    Signals, picked because each lies on its own:

    * device busy time from ``/proc/diskstats`` -- the drive had work queued;
    * weighted io time -- the average queue length, which is what actually
      distinguishes "the drive is working" from "the drive is backed up";
    * ``Dirty``/``Writeback`` -- the kernel still owes the drive bytes that no
      process is waiting on yet (the page cache absorbs the write and the stall
      only appears later, in a kworker).

    PSI is deliberately not part of the default gate.  ``/proc/pressure/io`` is
    the *root* cgroup, and on this host it is dominated by kernel writeback
    threads blocked in ``rq_qos_wait`` because blk-wbt throttles them by
    design.  That pins root ``full`` at 50-100% whenever writeback is in flight
    while the ctbrec cgroup and user.slice read near zero, so it cannot be
    compared with any threshold.  It stays available via
    ``--io-wait-threshold`` for hosts where it is meaningful.
    """

    def __init__(self, targets):
        self.targets = targets or []
        self.prev = None

    def _read(self):
        return (time.monotonic(), psi_full_total(),
                diskstats_io(self.targets), meminfo_unflushed())

    def prime(self):
        self.prev = self._read()

    def read(self, window=2.0):
        if self.prev is None:
            self.prime()
        time.sleep(window)
        cur = self._read()
        t0, psi0, io0, _ = self.prev
        t1, psi1, io1, dirty = cur
        self.prev = cur
        dt = max(1e-6, t1 - t0)
        util = aqu = stall = None
        busy0, weight0 = io0
        busy1, weight1 = io1
        if None not in (busy0, busy1):
            util = min(100.0, max(0.0, 100.0 * (busy1 - busy0) / 1000.0 / dt))
        if None not in (weight0, weight1):
            # weighted_ms / elapsed_ms is the mean queue depth over the window
            aqu = max(0.0, (weight1 - weight0) / 1000.0 / dt)
        if psi0 is not None and psi1 is not None:
            stall = min(100.0, max(0.0, 100.0 * (psi1 - psi0) / 1e6 / dt))
        return {"util": util, "stall": stall, "aqu": aqu,
                "dirty_mb": None if dirty is None else dirty / 1e6}


def window_means(hist):
    """Mean of each signal over the samples collected so far."""
    out = {}
    for key in ("util", "stall", "aqu", "dirty_mb"):
        vals = [h[key] for h in hist]
        out[key] = None if any(v is None for v in vals) else sum(vals) / len(vals)
    return out


def drain_reasons(args, mean):
    """Which signals say the disk is still working, using window means."""
    why = []
    queue_max = getattr(args, "drain_queue_max", 0) or 0
    if queue_max > 0 and mean["aqu"] is not None and mean["aqu"] > queue_max:
        why.append(f"queue {mean['aqu']:.1f} deep")
    if mean["util"] is not None and mean["util"] > args.disk_busy_threshold:
        why.append(f"disk {mean['util']:.0f}% busy")
    if mean["stall"] is not None and mean["stall"] > args.io_wait_threshold:
        why.append(f"{mean['stall']:.0f}% root io stall")
    if args.drain_dirty_mb > 0 and mean["dirty_mb"] is not None \
            and mean["dirty_mb"] > args.drain_dirty_mb:
        why.append(f"{mean['dirty_mb']:.0f} MB unflushed")
    return why


def wait_for_drain(args, sampler, cooldown=True):
    """Gate a merge burst until the disk has caught up and stayed caught up.

    The signals are means over ``--drain-window`` seconds rather than single
    samples, because a one-second sample of this drive routinely reads 80-95%
    busy from a single page-cache flush while the drive is only a few percent
    utilised over the same minute.

    "Caught up" is judged from the device and the page cache, not from PSI.
    PSI ``full`` is reported for the cgroup it is read from, and
    ``/proc/pressure/io`` is the root cgroup, where it is dominated by kernel
    writeback threads that blk-wbt throttles on purpose: it reads 50-100% for
    as long as any writeback is in flight, so gating on it waits forever.

    Returns False when the disk is still busy after --io-wait-max and the mode
    says to stop rather than pile another burst onto the backlog.
    """
    if cooldown and args.cooldown > 0:
        time.sleep(args.cooldown)
    if args.io_wait_max <= 0 or sampler is None:
        return True
    tick = max(0.2, args.drain_sample)
    depth = max(2, int(round(max(tick, args.drain_window) / tick)))
    hist = deque(maxlen=depth)
    started = time.monotonic()
    deadline = started + args.io_wait_max
    quiet_since = None
    notified = 0.0
    sampler.prime()
    while time.monotonic() < deadline:
        hist.append(sampler.read(tick))
        if len(hist) < depth:
            continue
        mean = window_means(hist)
        why = drain_reasons(args, mean)
        if not why:
            now = time.monotonic()
            if quiet_since is None:
                quiet_since = now
            elif now - quiet_since >= args.drain_quiet:
                return True
            continue
        quiet_since = None
        now = time.monotonic()
        if not notified or now - notified >= 15.0:
            lead = "waiting for disk" if not notified else "still waiting"
            print(f"  {lead} ({', '.join(why)}; {args.drain_window:.0f}s mean, "
                  f"{now - started:.0f}s so far, limit {args.io_wait_max:.0f}s)")
            notified = now
    mean = window_means(hist) if hist else \
        {"util": None, "stall": None, "aqu": None, "dirty_mb": None}
    why = drain_reasons(args, mean)
    if not why:
        # Ran out of time while the window was still filling, but everything in
        # it is below the thresholds -- that is quiet, not busy.
        return True
    print(f"  disk still busy after {args.io_wait_max:.0f}s ({', '.join(why)})",
          file=sys.stderr)
    if args.drain_timeout_action != "proceed":
        return False
    # Proceeding is safe when the load belongs to the recordings: a capped,
    # one-job merge adds little.  It is not safe when the page cache still owes
    # hundreds of megabytes of *our* writes -- that backlog is what boils over
    # into a saturated disk a few seconds later.
    if args.drain_dirty_mb > 0 and mean["dirty_mb"] is not None \
            and mean["dirty_mb"] > args.drain_dirty_mb:
        print(f"  stopping instead: {mean['dirty_mb']:.0f} MB still unflushed "
              f"(limit {args.drain_dirty_mb:.0f} MB); the next run will continue", file=sys.stderr)
        return False
    return True


def find_chain_groups(rows, threshold):
    groups = []
    cur = [rows[0]]
    for r in rows[1:]:
        gap = r["start"] - (cur[-1]["start"] + cur[-1]["dur"])
        if -threshold <= gap <= threshold:
            cur.append(r)
        else:
            if len(cur) >= 2:
                groups.append(cur)
            cur = [r]
    if len(cur) >= 2:
        groups.append(cur)
    return groups


def collect_entries(cpath, now, age, active_paths=None):
    entries = []
    active = 0
    for name in sorted(os.listdir(cpath)):
        if not (name.endswith(".ts") or name.endswith(".mts")):
            continue
        parsed = parse_filename(name)
        if not parsed:
            continue
        path = os.path.join(cpath, name)
        try:
            st = os.stat(path)
        except OSError:
            continue
        if active_paths and (st.st_dev, st.st_ino) in active_paths:
            active += 1
            continue
        if now - st.st_mtime <= age:
            active += 1
            continue
        entries.append({
            "name": name, "path": path,
            "model": parsed[0], "start": parsed[1],
            "size": st.st_size, "mtime": st.st_mtime,
            "dir": cpath,
        })
    return entries, active


def process_group(model, entries, args):
    entries = sorted(entries, key=lambda e: e["start"])
    candidates = []
    for prev, cur in zip(entries, entries[1:]):
        gap_mtime = cur["start"] - prev["mtime"]
        if gap_mtime <= args.gap + args.slack:
            if not candidates or candidates[-1] is not prev:
                candidates.append(prev)
            if not candidates or candidates[-1] is not cur:
                candidates.append(cur)
    if len(candidates) >= 2:
        print(f"scanning [{model}] ({len(candidates)} candidate file(s))")
    if len(candidates) < 2:
        return (0, 0, 0, 0, 0, [])

    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
        results = list(ex.map(lambda e: (e, probe_header(e["path"])), candidates))
    by_path = {}
    for e, p in results:
        if p is None:
            print(f"  warn: could not probe {e['name']}", file=sys.stderr)
            continue
        e["start_time"], e["vsig"], e["asig"], e["pids"] = p
        e["dur"] = max(0.0, e["mtime"] - e["start"])
        by_path[e["path"]] = e
    candidates = [e for e in candidates if e["path"] in by_path]
    candidates.sort(key=lambda e: e["start"])

    groups = find_chain_groups(candidates, args.gap)

    merged = bytes_out = n_del = n_keep = skipped = 0
    summary = []
    for group in groups:
        parts = [group[0]]
        for e in group[1:]:
            if e["vsig"] == parts[-1]["vsig"] and e["asig"] == parts[-1]["asig"]:
                parts.append(e)
            else:
                if len(parts) >= 2:
                    res = merge_run(parts, args)
                    if res["merged"]:
                        merged += 1
                        bytes_out += res["size"]
                        n_del += res["n_del"]
                        n_keep += res["n_keep"]
                        summary.append(res)
                else:
                    skipped += len(parts)
                parts = [e]
        if len(parts) >= 2:
            res = merge_run(parts, args)
            if res["merged"]:
                merged += 1
                bytes_out += res["size"]
                n_del += res["n_del"]
                n_keep += res["n_keep"]
                summary.append(res)
        else:
            skipped += len(parts)
    return (merged, bytes_out, n_del, n_keep, skipped, summary)


def append_preflight(group):
    if len(group) < 2:
        return None
    sizes = {}
    for e in group:
        ps = ts_packet_size(e["path"])
        if ps is None:
            return None
        sizes[e["path"]] = ps
    if len(set(sizes.values())) != 1:
        return None
    ps = next(iter(sizes.values()))
    if any(e["size"] % ps != 0 for e in group):
        return None
    if group[0].get("start_time") is None:
        return None
    if any(e.get("pids") != group[0].get("pids") for e in group[1:]):
        return None
    return {"packet": ps, "start_time": group[0]["start_time"]}


def rate_txt(started, in_bytes, out_bytes):
    """'12s, 74 MB/s' for the work a single group just did."""
    elapsed = max(0.001, time.monotonic() - started)
    mbps = (in_bytes + out_bytes) / elapsed / 1e6
    return f"{elapsed:.0f}s, {mbps:.0f} MB/s"


def merge_run(group, args):
    gaps = []
    for prev, cur in zip(group, group[1:]):
        gaps.append(round(cur["start"] - (prev["start"] + prev["dur"])))
    gap_txt = ", ".join(f"{g}s" for g in gaps)

    model = group[0]["model"]
    out_name = group[0]["name"]
    out_path = group[0]["path"]
    in_sizes = sum(e["size"] for e in group)
    in_durs = sum(e["dur"] for e in group)

    print(f"merge [{model}]")
    for e in group:
        print(f"  + {e['name']}  ({e['dur']:.0f}s)")
    print(f"  -> {out_name}  gaps: {gap_txt}")

    base = {"model": model, "name": out_name, "parts": len(group), "gaps": gap_txt}

    pre = None if args.keep else append_preflight(group)
    mode = "append" if (args.append and pre) else "concat"
    print(f"     mode: {mode}")

    if args.dry_run:
        base.update({"merged": False, "size": 0, "n_del": 0, "n_keep": 0})
        return base

    du = shutil.disk_usage(group[0]["dir"])
    need = (in_sizes - group[0]["size"] if mode == "append" else in_sizes) + FREE_MARGIN_BYTES
    if du.free < need:
        print(f"  skip: need {need/1e9:.1f} GB free, have {du.free/1e9:.1f} GB", file=sys.stderr)
        return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}

    if mode == "append":
        return append_run(group, args, pre, base, gaps)

    part_path = out_path + ".part"
    global CURRENT_PART
    CURRENT_PART = part_path
    try:
        os.remove(part_path)
    except OSError:
        pass
    list_txt = "".join(f"file '{e['path']}'\n" for e in group)
    print(f"  remuxing {len(group)} parts with ffmpeg concat")
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as tf:
        tf.write(list_txt)
        list_path = tf.name
    started = time.monotonic()
    limiter = RateLimiter(parse_rate(args.io_rate))
    proc = None
    try:
        cmd = io_priority_prefix(args) + [
               "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
               "-f", "concat", "-safe", "0", "-i", list_path,
               "-map", "0", "-c", "copy", "-f", "mpegts", "pipe:1"]
        errf = tempfile.TemporaryFile()
        # The output is copied through this process rather than written by
        # ffmpeg directly: a direct write lands in the page cache at memory
        # speed and the real disk burst only starts later in writeback, where
        # neither the token bucket nor the cgroup cap can shape it.
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=errf)
        except OSError as exc:
            rc = 127
            stderr = f"could not run ffmpeg: {exc}"
        else:
            with open(part_path, "wb") as f:
                while True:
                    chunk = proc.stdout.read(1 << 20)
                    if not chunk:
                        break
                    f.write(chunk)
                    limiter.add(len(chunk))
                f.flush()
                os.fsync(f.fileno())
            rc = proc.wait()
            errf.seek(0)
            stderr = errf.read().decode(errors="replace")
            errf.close()
    finally:
        if proc is not None:
            try:
                proc.stdout.close()
            except OSError:
                pass
            if proc.poll() is None:
                proc.kill()
                proc.wait()
        os.remove(list_path)
    CURRENT_PART = None
    if rc != 0:
        print(f"  error: ffmpeg failed, kept originals\n{stderr}", file=sys.stderr)
        try:
            os.remove(part_path)
        except OSError:
            pass
        return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}

    out_size = os.path.getsize(part_path)
    if abs(out_size - in_sizes) > max(2 * 1024 * 1024, 0.03 * in_sizes):
        print(f"  error: output size {out_size} vs input sum {in_sizes}, kept originals", file=sys.stderr)
        try:
            os.remove(part_path)
        except OSError:
            pass
        return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}

    if args.verify:
        p = probe_duration(part_path)
        if p is None or abs(p - in_durs) > max(5.0, 0.02 * in_durs):
            print(f"  error: verify failed, kept originals", file=sys.stderr)
            try:
                os.remove(part_path)
            except OSError:
                pass
            return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}

    n_del = n_keep = 0
    global DELETED_SO_FAR, KEPT_SO_FAR
    for e in group:
        if args.keep:
            bak = os.path.join(e["dir"], ".merged_originals")
            os.makedirs(bak, exist_ok=True)
            dest = os.path.join(bak, e["name"])
            i = 1
            while os.path.exists(dest):
                dest = os.path.join(bak, f"{e['name']}.{i}")
                i += 1
            os.rename(e["path"], dest)
            n_keep += 1
            KEPT_SO_FAR += 1
        else:
            os.remove(e["path"])
            n_del += 1
            DELETED_SO_FAR += 1

    os.rename(part_path, out_path)

    print(f"  ok: {out_name} ({out_size/1e6:.0f} MB, "
          f"{rate_txt(started, in_sizes, out_size)}), "
          f"originals {'kept' if args.keep else 'deleted'}")
    return {"merged": True, **base, "size": out_size, "n_del": n_del, "n_keep": n_keep}


def append_run(group, args, pre, base, gaps):
    global CURRENT_APPEND, CURRENT_APPEND_SIZE, DELETED_SO_FAR
    out_path = group[0]["path"]
    orig_size = os.path.getsize(out_path)
    start1 = pre["start_time"]
    last_off = start1
    # Content-continuous offsets: place each part immediately after the
    # previous part's content instead of at its wall-clock position, so the
    # merged timeline has no phantom gaps and byte<->time seeking stays linear.
    cur_end = start1 + max(0.0, group[0]["mtime"] - group[0]["start"])
    appended = 0
    limiter = RateLimiter(parse_rate(args.io_rate))
    started = time.monotonic()
    CURRENT_APPEND = out_path
    CURRENT_APPEND_SIZE = orig_size
    with open(out_path, "ab") as f:
        for e in group[1:]:
            off = cur_end - e.get("start_time", 0.0)
            if off < last_off + APPEND_MARGIN:
                off = last_off + APPEND_MARGIN
            print(f"  appending {e['name']} ({e['size']/1e6:.0f} MB)")
            cmd = io_priority_prefix(args) + [
                   "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                   "-i", e["path"], "-map", "0", "-c", "copy",
                   "-muxdelay", "0", "-muxpreload", "0",
                   "-output_ts_offset", f"{off:.3f}",
                   "-f", "mpegts", "pipe:1"]
            errf = tempfile.TemporaryFile()
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=errf)
            except OSError as exc:
                errf.close()
                f.flush()
                os.truncate(out_path, orig_size)
                CURRENT_APPEND = None
                print(f"  error: could not run ffmpeg: {exc}, part rolled back, "
                      f"kept originals", file=sys.stderr)
                return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}
            try:
                while True:
                    chunk = proc.stdout.read(1 << 20)
                    if not chunk:
                        break
                    f.write(chunk)
                    limiter.add(len(chunk))
                rc = proc.wait()
            finally:
                if proc.poll() is None:
                    proc.kill()
                    proc.wait()
                proc.stdout.close()
                errf.seek(0)
                stderr = errf.read().decode(errors="replace")
                errf.close()
            if rc != 0:
                f.flush()
                os.truncate(out_path, orig_size)
                CURRENT_APPEND = None
                print(f"  error: ffmpeg append failed, part rolled back, kept originals\n{stderr}", file=sys.stderr)
                return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}
            last_off = off
            cur_end = off + e.get("start_time", 0.0) + max(0.0, e["mtime"] - e["start"])
            appended += e["size"]
        f.flush()
        os.fsync(f.fileno())
    new_size = os.path.getsize(out_path)
    expected = orig_size + appended
    if abs(new_size - expected) > max(2 * 1024 * 1024, 0.03 * expected):
        os.truncate(out_path, orig_size)
        CURRENT_APPEND = None
        print(f"  error: appended size {new_size} vs expected {expected}, part rolled back", file=sys.stderr)
        return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}

    if args.verify:
        p = probe_duration(out_path)
        expected_dur = cur_end - start1
        bad = p is None or abs(p - expected_dur) > max(10.0, 0.05 * expected_dur)
        nj = 0 if bad else len(scan_pts_jumps(out_path))
        if bad or nj:
            os.truncate(out_path, orig_size)
            CURRENT_APPEND = None
            print(f"  error: verify failed ({nj} PTS discontinuity/ies), part rolled back", file=sys.stderr)
            return {"merged": False, **base, "size": 0, "n_del": 0, "n_keep": 0}

    n_del = len(group) - 1
    for e in group[1:]:
        os.remove(e["path"])
        DELETED_SO_FAR += 1
    CURRENT_APPEND = None
    CURRENT_APPEND_SIZE = 0

    print(f"  ok: {group[0]['name']} ({new_size/1e6:.0f} MB, "
          f"{rate_txt(started, appended, appended)}), appended {len(group)-1} part(s), "
          f"{appended/1e6:.0f} MB folded in")
    return {"merged": True, **base, "size": new_size, "n_del": n_del, "n_keep": 0}


def remove_quiet(path):
    try:
        os.remove(path)
    except OSError:
        pass


def probe_gap_ratio(path, sample_seconds):
    """Cheaply estimate the phantom (gap) timeline of a file.

    The container duration is compared against the duration implied by the
    filesize and the content bitrate sampled from the opening seconds (which is
    always real content, never a gap).  A ratio above 1 means part of the
    timeline is backed by no bytes -- i.e. seeking will jump.  Returns a dict or
    None when the file cannot be measured.
    """
    try:
        size = os.path.getsize(path)
    except OSError:
        return None
    if size <= 0 or sample_seconds <= 0:
        return None
    dur = probe_duration(path)
    if dur is None or dur <= 0:
        return None
    cmd = ["ffprobe", "-v", "error",
           "-read_intervals", f"0%+{sample_seconds:g}",
           "-show_entries", "packet=size",
           "-of", "default=nw=1:nk=1", path]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return None
    total = n = 0
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line or line == "N/A":
            continue
        try:
            total += int(line)
            n += 1
        except ValueError:
            pass
    if n < 100 or total <= 0:
        return None
    # PES payload bytes -> on-disk bytes (4-byte TS header per 188-byte packet).
    bytes_per_sec = total * (188.0 / 184.0) / sample_seconds
    est = size / bytes_per_sec
    return {"size": size, "duration": dur, "est": est,
            "ratio": dur / est, "gap": dur - est}


def scan_pts_jumps(path, max_jump=2.0, chunk_packets=20000):
    """Stream a transport stream and return PTS discontinuities over max_jump.

    Unlike ffprobe, whose demuxer silently repairs timestamp discontinuities,
    this reads the raw PES headers, so it is the ground truth for whether a
    player seeking by PCR/PTS would jump.
    """
    chunk = 188 * chunk_packets
    jumps = []
    last = {}
    with open(path, "rb") as f:
        offset = 0
        carry = b""
        while True:
            buf = f.read(chunk)
            if not buf:
                break
            data = carry + buf
            end = len(data) - (len(data) % 188)
            i = 0
            while i < end:
                if data[i] == 0x47:
                    pid = ((data[i + 1] & 0x1F) << 8) | data[i + 2]
                    if data[i + 1] & 0x40:  # payload unit start indicator
                        afc = (data[i + 3] >> 4) & 0x3
                        idx = i + 4
                        if afc & 0x2:
                            idx = i + 5 + data[i + 4]
                        if (afc & 0x1) and idx + 14 <= i + 188 and data[idx:idx + 3] == b"\x00\x00\x01":
                            if data[idx + 7] & 0x80:  # PTS present
                                pts = (((data[idx + 9] >> 1) & 0x7) << 30) | (data[idx + 10] << 22) | \
                                      ((data[idx + 11] >> 1) << 15) | (data[idx + 12] << 7) | (data[idx + 13] >> 1)
                                t = pts / 90000.0
                                prev = last.get(pid)
                                if prev is not None and abs(t - prev) > max_jump:
                                    jumps.append((pid, offset + i, prev, t))
                                last[pid] = t
                i += 188
            carry = data[end:]
            offset += end
    return jumps


def backing_device(path):
    """Block device backing path, or None for network/virtual filesystems."""
    r = subprocess.run(["findmnt", "-no", "SOURCE", "--target", path],
                       capture_output=True, text=True)
    src = r.stdout.strip()
    if src.startswith("/dev/"):
        return src
    return None


def io_priority_prefix(args):
    """Run a child at low CPU/IO priority, hard-capped on disk bandwidth.

    The bandwidth cap lives in the child's own cgroup, so an unrelated ffmpeg
    encode reading the same disk (via a different cgroup, e.g. through Samba)
    keeps its share of the device.  Falls back to nice/ionice alone when no
    block device backs --dir, when --io-rate is off, or when the systemd scope
    is unavailable.
    """
    inner = ["nice", "-n", str(args.nice)]
    if args.io_class == "idle":
        inner += ["ionice", "-c3"]
    else:
        inner += ["ionice", "-c2", "-n7"]
    rate = (args.io_rate or "").strip()
    device = args.io_device or backing_device(args.dir)
    if rate and rate not in ("0", "off", "none") and device and args.io_scope:
        return ["systemd-run", "--scope", "-q", "--collect", "--no-ask-password",
                "-p", f"IOReadBandwidthMax={device} {rate}",
                "-p", f"IOWriteBandwidthMax={device} {rate}",
                "-p", f"IOWeight={args.io_weight}",
                "--"] + inner
    return inner


def io_scope_works(args):
    """Probe once whether a systemd io scope can be created.

    Without the probe a D-Bus or controller problem would make every merge
    fail instead of silently degrading to nice/ionice.
    """
    rate = (args.io_rate or "").strip()
    if not rate or rate in ("0", "off", "none"):
        return False
    if not shutil.which("systemd-run"):
        return False
    try:
        r = subprocess.run(
            ["systemd-run", "--scope", "-q", "--collect", "--no-ask-password",
             "-p", "IOWeight=10", "--", "true"],
            capture_output=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def ensure_io_scope(args):
    """Probe the io scope lazily, only once real work is about to start."""
    if getattr(args, "io_scope", None) is not None:
        return args.io_scope
    args.io_scope = io_scope_works(args)
    rate = (args.io_rate or "").strip()
    if not args.io_scope and rate and rate not in ("0", "off", "none"):
        dev = args.io_device or backing_device(args.dir)
        if dev:
            print(f"warn: io cap {rate} unavailable on {dev} (no usable systemd "
                  f"scope); falling back to nice/ionice", file=sys.stderr)
    return args.io_scope


class RateLimiter:
    """Average-rate limiter for data copied through userspace.

    Append mode streams ffmpeg's stdout into the file, so the write happens in
    this process and no cgroup sandbox can throttle it.  Throttling the copy
    rate also throttles ffmpeg, because the pipe backs up and it blocks on
    write -- so one limiter paces both the read and the write side.
    """

    def __init__(self, rate):
        self.rate = rate
        self.started = time.monotonic()
        self.done = 0

    def add(self, nbytes):
        if self.rate <= 0:
            return
        self.done += nbytes
        ahead = self.done / self.rate - (time.monotonic() - self.started)
        if ahead > 0:
            time.sleep(min(ahead, 5.0))


def parse_rate(rate):
    """'80M' / '40M' / '2G' / '0' -> bytes per second (0 = no cap)."""
    rate = (rate or "").strip()
    if not rate or rate in ("0", "off", "none"):
        return 0.0
    mult = 1
    if rate[-1] in "kKmMgG":
        mult = {"k": 1e3, "m": 1e6, "g": 1e9}[rate[-1].lower()]
        rate = rate[:-1]
    try:
        return float(rate) * mult
    except ValueError:
        return 0.0



def fix_one(path, args):
    """Remux one file in place to collapse phantom timeline gaps.

    The output is written to a .part file and only renamed into place after the
    raw PTS discontinuity scan confirms the timeline is continuous.  On any
    failure the original is left untouched.
    """
    global CURRENT_PART
    try:
        size = os.path.getsize(path)
    except OSError as exc:
        return False, f"stat failed: {exc}", 0
    part = path + ".part"
    CURRENT_PART = part
    remove_quiet(part)
    limiter = RateLimiter(parse_rate(args.io_rate))
    cmd = io_priority_prefix(args) + [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
        "-i", path, "-map", "0", "-c", "copy", "-f", "mpegts", "pipe:1",
    ]
    errf = tempfile.TemporaryFile()
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=errf)
    except OSError as exc:
        errf.close()
        CURRENT_PART = None
        return False, f"could not run ffmpeg: {exc}", 0
    # As with merging, the bytes are copied here instead of written by ffmpeg,
    # so the rate applies to the actual write and not just to a page-cache
    # hand-off.
    try:
        with open(part, "wb") as f:
            while True:
                chunk = proc.stdout.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                limiter.add(len(chunk))
            f.flush()
            os.fsync(f.fileno())
        rc = proc.wait()
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        proc.stdout.close()
        errf.seek(0)
        stderr = errf.read().decode(errors="replace")
        errf.close()
    if rc != 0:
        remove_quiet(part)
        CURRENT_PART = None
        return False, f"ffmpeg failed: {stderr.strip()[:300]}", 0
    out_size = os.path.getsize(part)
    if abs(out_size - size) > max(2 * 1024 * 1024, 0.03 * size):
        remove_quiet(part)
        CURRENT_PART = None
        return False, f"output size {out_size} vs input {size}", 0
    # The remux must have collapsed the merge-scale phantom gaps.  Genuine
    # small source dropouts (a few seconds) are inherent to the recording and
    # cannot be removed with a stream copy, so only large jumps are rejected.
    jumps = scan_pts_jumps(part)
    big = [j for j in jumps if abs(j[3] - j[2]) > 60.0]
    if big:
        remove_quiet(part)
        CURRENT_PART = None
        return False, f"{len(big)} large PTS discontinuity/ies remain (e.g. {big[0]})", 0
    if args.keep:
        bak = os.path.join(os.path.dirname(path), ".merged_originals")
        os.makedirs(bak, exist_ok=True)
        dest = os.path.join(bak, os.path.basename(path))
        i = 1
        while os.path.exists(dest):
            dest = os.path.join(bak, f"{os.path.basename(path)}.{i}")
            i += 1
        os.rename(path, dest)
        os.rename(part, path)
    else:
        os.replace(part, path)
    CURRENT_PART = None
    return True, out_size, len(jumps)


def run_repair(args, active_paths, now):
    """Repair already-merged files whose timeline has phantom gaps."""
    files = sorted(os.listdir(args.dir))
    subdirs = [d for d in files if os.path.isdir(os.path.join(args.dir, d))]
    top_files = [f for f in files if os.path.isfile(os.path.join(args.dir, f))]
    has_top = any(parse_filename(f) for f in top_files)
    if args.top_level or has_top or not subdirs:
        dirs = [args.dir]
    else:
        dirs = [os.path.join(args.dir, d) for d in subdirs]

    entries = []
    for d in dirs:
        es, _act = collect_entries(d, now, args.age, active_paths)
        entries.extend(es)
    entries.sort(key=lambda e: e["start"])
    print(f"scanning {len(entries)} file(s) for phantom timeline gaps...")

    selected = []
    for e in entries:
        info = probe_gap_ratio(e["path"], args.fix_sample)
        if info is None:
            continue
        e.update(info)
        if info["ratio"] > args.fix_threshold:
            selected.append(e)

    total_gb = sum(e["size"] for e in selected) / 1e9
    gap_h = sum(e["gap"] for e in selected) / 3600.0
    print(f"found {len(selected)} file(s) with ratio > {args.fix_threshold:g} "
          f"({total_gb:.1f} GB, ~{gap_h:.1f} h of phantom timeline)")
    for e in sorted(selected, key=lambda e: e["ratio"], reverse=True):
        print(f"  {e['ratio']:.2f}x  gap~{e['gap']:.0f}s  {e['size']/1e9:.2f}GB  {e['name']}")

    if args.dry_run or not selected:
        return 0

    rate = (args.io_rate or "").strip()
    device = args.io_device or backing_device(args.dir)
    ensure_io_scope(args)
    if rate and rate not in ("0", "off", "none"):
        if device and args.io_scope:
            print(f"io cap: {rate} read/write on {device}, weight {args.io_weight}, nice {args.nice}")
        elif device:
            print("io cap: unavailable, using nice/ionice only", file=sys.stderr)

    sampler = DiskSampler(device_targets(args.dir))
    fixed = failed = 0
    written = 0
    budget = args.max_run_gb * 1e9
    for i, e in enumerate(selected):
        du = shutil.disk_usage(os.path.dirname(e["path"]))
        need = e["size"] + FREE_MARGIN_BYTES
        if du.free < need:
            print(f"  skip {e['name']}: need {need/1e9:.1f} GB free, "
                  f"have {du.free/1e9:.1f} GB", file=sys.stderr)
            continue
        if not wait_for_drain(args, sampler, cooldown=i > 0):
            print("stopping: disk still saturated, next run will continue", file=sys.stderr)
            break
        print(f"fixing {e['name']} ({e['ratio']:.2f}x, {e['size']/1e9:.2f} GB)")
        ok, res, residual = fix_one(e["path"], args)
        if ok:
            fixed += 1
            written += res
            note = f", {residual} small source dropout(s) kept" if residual else ""
            print(f"  ok: {e['name']} ({res/1e6:.0f} MB), gaps removed{note}")
        else:
            failed += 1
            print(f"  error: {e['name']}: {res}, kept original", file=sys.stderr)
        if budget and written >= budget:
            print(f"run budget reached ({args.max_run_gb:.0f} GB); stopping", file=sys.stderr)
            break

    print(f"\ndone: {fixed} file(s) repaired ({written/1e6:.0f} MB output)")
    if failed:
        print(f"      {failed} failed (original kept)")
    return 0


MODES = {
    # mode      io cap  weight  nice  class  jobs cooldown wait  stall% busy%  dirty   timeout
    # stalled/busy are compared against means over a --drain-window long window.
    # PSI (io_wait_threshold) is off by default: root-cgroup io pressure is
    # dominated by kernel writeback threads throttled by blk-wbt and reads
    # 50-100% whenever any writeback is in flight, so it cannot be thresholded.
    # The gate uses average queue depth (drain_queue_max) and the unflushed
    # backlog instead.  Measured on this host: idle between groups reads
    # queue 0.0 / busy 0% / dirty <70 MB; while merging, queue 3-13 / busy
    # 60-100% / dirty 400-500 MB.
    "max": dict(io_rate="0", io_weight=1000, nice=0, io_class="best-effort", jobs=8,
                cooldown=0.0, io_wait_max=0.0, io_wait_threshold=100.0,
                disk_busy_threshold=100.0, drain_dirty_mb=0.0, drain_queue_max=0.0,
                drain_window=5.0, drain_quiet=3.0,
                drain_timeout_action="proceed"),
    "balanced": dict(io_rate="90M", io_weight=100, nice=10, io_class="best-effort", jobs=1,
                     cooldown=5.0, io_wait_max=120.0, io_wait_threshold=100.0,
                     disk_busy_threshold=60.0, drain_dirty_mb=256.0, drain_queue_max=1.5,
                     drain_window=5.0, drain_quiet=3.0,
                     drain_timeout_action="proceed"),
    "reserved": dict(io_rate="40M", io_weight=10, nice=19, io_class="idle", jobs=1,
                     cooldown=30.0, io_wait_max=600.0, io_wait_threshold=100.0,
                     disk_busy_threshold=30.0, drain_dirty_mb=64.0, drain_queue_max=0.7,
                     drain_window=8.0, drain_quiet=5.0,
                     drain_timeout_action="stop"),
}


def main():
    ap = argparse.ArgumentParser(
        prog="ctbrec-merge",
        description="Losslessly merge ctbrec recordings of the same model that were split by a restart (small gaps).",
    )
    ap.add_argument("-m", "--mode", choices=sorted(MODES), default="balanced",
                    help="io policy preset: max = all bandwidth, no waits; "
                         "balanced = capped, brief waits (default); "
                         "reserved = heavy cap, stops when the disk stays busy")
    ap.add_argument("--status", action="store_true",
                    help="print current disk busy/stall/unflushed figures and the active policy, then exit")
    ap.add_argument("--dir", default="/mnt/pve/Data_Storage/ctbrec",
                    help="base directory (one folder per model, or flat .mts files)")
    ap.add_argument("--gap", type=int, default=3600,
                    help="max gap in seconds between recordings to merge (default 3600)")
    ap.add_argument("--slack", type=int, default=30,
                    help="extra seconds of slack when finding candidates via mtime (default 30)")
    ap.add_argument("--age", type=int, default=300,
                    help="skip files modified in the last N seconds (default 300)")
    ap.add_argument("--no-lsof", action="store_true",
                    help="skip the open-for-write activity check (fall back to --age only)")
    ap.add_argument("--keep", action="store_true",
                    help="move merged originals to .merged_originals/ instead of deleting (disables append)")
    ap.add_argument("--dry-run", action="store_true",
                    help="print the merge plan without changing anything")
    ap.add_argument("--top-level", action="store_true",
                    help="only process files directly in --dir, never enter subdirectories")
    ap.add_argument("--verify", action="store_true",
                    help="verify merged output duration with ffprobe (extra full read)")
    ap.add_argument("-j", "--jobs", type=int, default=None,
                    help="parallel header probes (default: from --mode, 1 except max)")
    ap.add_argument("--no-append", dest="append", action="store_false",
                    help="disable byte-append merging, always remux via ffmpeg concat")
    ap.add_argument("--min-free-pct", type=float, default=3.81,
                    help="refuse to run when the filesystem is less than this percent free (default 3.81)")
    ap.add_argument("--max-streams", type=int, default=4,
                    help="defer when more than this many recordings are open for writing (default 4)")
    ap.add_argument("--max-run-gb", type=float, default=0.0,
                    help="stop after this many GB of output per run; 0 disables (default unlimited)")
    ap.add_argument("--fix-timestamps", action="store_true",
                    help="repair already-merged files with phantom timeline gaps (remux in place) instead of merging")
    ap.add_argument("--fix-threshold", type=float, default=1.05,
                    help="repair files whose container/content duration ratio exceeds this (default 1.05)")
    ap.add_argument("--fix-sample", type=float, default=60.0,
                    help="seconds of packets to sample when estimating content duration (default 60)")

    adv = ap.add_argument_group("pacing overrides (normally set by --mode)")
    adv.add_argument("--io-rate", default=None,
                     help="hard read/write bandwidth cap per device, e.g. 90M; 0 disables")
    adv.add_argument("--io-weight", type=int, default=None,
                     help="cgroup io weight for merge/repair ffmpeg (1-10000)")
    adv.add_argument("--nice", type=int, default=None,
                     help="nice level for merge/repair ffmpeg")
    adv.add_argument("--io-class", choices=["best-effort", "idle"], default=None,
                     help="ionice class for merge/repair ffmpeg")
    adv.add_argument("--cooldown", type=float, default=None,
                     help="minimum seconds to sleep between groups")
    adv.add_argument("--io-wait-max", type=float, default=None,
                     help="max seconds to wait for the disk to drain before each group; 0 disables")
    adv.add_argument("--io-wait-threshold", type=float, default=None,
                     help="root-cgroup io stall percent considered drained; 100 disables "
                          "(default: disabled, see --drain-queue-max)")
    adv.add_argument("--disk-busy-threshold", type=float, default=None,
                     help="device busy percent considered drained; compared against a --drain-window mean")
    adv.add_argument("--drain-queue-max", type=float, default=None,
                     help="average device queue depth considered drained (the main gate); 0 disables")
    adv.add_argument("--drain-dirty-mb", type=float, default=None,
                     help="dirty+writeback megabytes still owed to the disk that counts as busy; 0 ignores")
    adv.add_argument("--drain-sample", type=float, default=1.0,
                     help="seconds per sample when checking for drain (default 1)")
    adv.add_argument("--drain-window", type=float, default=None,
                     help="seconds of samples averaged before judging the disk (default 5)")
    adv.add_argument("--drain-quiet", type=float, default=None,
                     help="seconds the averaged signals must stay under the thresholds (default 3)")
    adv.add_argument("--drain-timeout-action", choices=["proceed", "stop"], default=None,
                     help="what to do when the disk is still busy after --io-wait-max")
    adv.add_argument("--io-device", default=None,
                     help="block device for the io cap (default: detected from --dir)")
    args = ap.parse_args()

    preset = MODES[args.mode]
    for key, val in preset.items():
        if getattr(args, key) is None:
            setattr(args, key, val)
    args.io_scope = None

    if not os.path.isdir(args.dir):
        print(f"error: {args.dir} is not a directory", file=sys.stderr)
        return 1

    if args.status:
        dev = args.io_device or backing_device(args.dir) or "no block device"
        devs = device_targets(args.dir)
        sampler = DiskSampler(devs)
        sampler.prime()
        st = sampler.read(max(0.5, args.drain_sample))

        tick = max(0.2, args.drain_sample)
        depth = max(2, int(round(max(tick, args.drain_window) / tick)))
        hist = deque(maxlen=depth)
        hist.append(st)
        for _ in range(depth - 1):
            hist.append(sampler.read(tick))
        mean = window_means(hist)

        def pct(v):
            return "n/a" if v is None else f"{v:.0f}%"

        def mb(v):
            return "n/a" if v is None else f"{v:.0f} MB"

        def num(v, fmt="{:.1f}"):
            return "n/a" if v is None else fmt.format(v)

        print(f"mode: {args.mode}  (io cap {args.io_rate or 'off'}, weight {args.io_weight}, jobs {args.jobs})")
        print(f"device: {dev}  [{', '.join(f'{a}:{b}' for a, b in devs) or 'no block device'}]")
        ensure_io_scope(args)
        print(f"scope: {'active' if args.io_scope else 'unavailable (nice/ionice only)'}")
        print(f"now ({tick:.0f}s): busy {pct(st['util'])}   queue {num(st['aqu'])}   "
              f"stall {pct(st['stall'])}   unflushed {mb(st['dirty_mb'])}")
        print(f"mean ({args.drain_window:.0f}s): busy {pct(mean['util'])}   queue {num(mean['aqu'])}   "
              f"stall {pct(mean['stall'])}   unflushed {mb(mean['dirty_mb'])}")
        print(f"gate: quiet when {args.drain_window:.0f}s-mean queue < {args.drain_queue_max:g}, "
              f"busy < {args.disk_busy_threshold:.0f}%, "
              f"unflushed < {args.drain_dirty_mb:.0f} MB for {args.drain_quiet:.0f}s "
              f"(wait {args.io_wait_max:.0f}s)")
        print("stall is the root cgroup's io pressure: kernel writeback threads "
              "dominate it, so it is reported but not gated on")
        return 0

    du = shutil.disk_usage(args.dir)
    free_pct = 100.0 * du.free / du.total
    if free_pct < args.min_free_pct:
        print(f"error: only {free_pct:.1f}% free (< --min-free-pct {args.min_free_pct:.0f}), refusing to merge", file=sys.stderr)
        return 1

    print(f"mode: {args.mode}  (io cap {args.io_rate or 'off'} x2, weight {args.io_weight}, "
          f"jobs {args.jobs}, cooldown {args.cooldown:.0f}s, "
          f"drain {args.io_wait_max:.0f}s @ queue <{args.drain_queue_max:g}, "
          f"busy <{args.disk_busy_threshold:.0f}%, "
          f"unflushed <{args.drain_dirty_mb:.0f} MB, {args.drain_window:.0f}s mean)")

    now = datetime.now().timestamp()
    active_paths = None
    if not args.no_lsof:
        active_paths = active_write_paths(args.dir)
        if active_paths is not None:
            print(f"active: {len(active_paths)} recording(s) open for writing")
            if len(active_paths) > args.max_streams:
                if args.dry_run:
                    print(f"note: {len(active_paths)} active recordings (> --max-streams {args.max_streams}); "
                          f"continuing because --dry-run changes nothing", file=sys.stderr)
                else:
                    print(f"deferring: {len(active_paths)} active recordings (> --max-streams {args.max_streams})", file=sys.stderr)
                    return 0

    if args.fix_timestamps:
        return run_repair(args, active_paths, now)

    files = sorted(os.listdir(args.dir))
    total_merged = 0
    total_bytes = 0
    deleted = 0
    kept = 0
    skipped_params = 0
    active = 0
    summary = []

    subdirs = [d for d in files if os.path.isdir(os.path.join(args.dir, d))]
    top_files = [f for f in files if os.path.isfile(os.path.join(args.dir, f))]
    has_top_recordings = any(parse_filename(f) for f in top_files)
    model_groups = []
    if args.top_level or has_top_recordings:
        entries, act = collect_entries(args.dir, now, args.age, active_paths)
        active += act
        by_model = {}
        for e in entries:
            by_model.setdefault(e["model"], []).append(e)
        model_groups = [(m, es) for m, es in by_model.items() if len(es) >= 2]
    elif subdirs:
        for d in subdirs:
            cpath = os.path.join(args.dir, d)
            entries, act = collect_entries(cpath, now, args.age, active_paths)
            active += act
            if len(entries) >= 2:
                model_groups.append((d, entries))

    budget = args.max_run_gb * 1e9
    sampler = None if args.dry_run else DiskSampler(device_targets(args.dir))
    if model_groups and not args.dry_run:
        ensure_io_scope(args)
    gate_next = True
    ran = 0
    for model, entries in model_groups:
        # Gate *before* the burst: the previous group's writes may still be in
        # the page cache or queued in the drive's SMR media cache, and adding
        # another burst on top of that is what pins the disk at 100%.
        if gate_next and not wait_for_drain(args, sampler, cooldown=ran > 0):
            print("stopping: disk still saturated, the next run will continue", file=sys.stderr)
            break
        merged, bytes_out, n_del, n_keep, skipped, res_summary = process_group(model, entries, args)
        total_merged += merged
        total_bytes += bytes_out
        deleted += n_del
        kept += n_keep
        skipped_params += skipped
        summary.extend(res_summary)
        ran += 1
        gate_next = bool(bytes_out)
        if budget and total_bytes >= budget:
            print(f"run budget reached ({args.max_run_gb:.0f} GB); stopping", file=sys.stderr)
            break

    if summary:
        print("\nSummary:")
        for s in summary:
            print(f"  {s['model']}: {s['parts']} parts -> {s['name']} ({s['size']/1e6:.0f} MB, gaps {s['gaps']})")
    print(f"\ndone: {total_merged} files merged ({total_bytes/1e6:.0f} MB output)")
    if deleted:
        print(f"      {deleted} originals deleted")
    if kept:
        print(f"      {kept} originals moved to .merged_originals/")
    if skipped_params:
        print(f"      {skipped_params} files not merged (codec/params differ)")
    if active:
        print(f"      {active} files skipped (open for writing or modified within --age)")
    return 0


def _sigterm(signum, frame):
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _sigterm)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        if CURRENT_PART:
            try:
                os.remove(CURRENT_PART)
            except OSError:
                pass
        if CURRENT_APPEND and CURRENT_APPEND_SIZE:
            try:
                os.truncate(CURRENT_APPEND, CURRENT_APPEND_SIZE)
            except OSError:
                pass
        print("\ninterrupted: partial output cleaned up", file=sys.stderr)
        if DELETED_SO_FAR or KEPT_SO_FAR:
            print(f"  note: {DELETED_SO_FAR} originals deleted, {KEPT_SO_FAR} moved to .merged_originals/ before interrupt", file=sys.stderr)
        sys.exit(130)
