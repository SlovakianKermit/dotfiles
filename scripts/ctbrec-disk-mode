#!/usr/bin/env python3
"""ctbrec-disk-mode - strict low-disk allowlist mode for ctbrec.

Runs inside the ctbrec LXC (proxmox VMID 109).  While free space on the
recordings filesystem is above the enter threshold every model records
normally.  At or below the enter threshold every model that is not on the
allowlist is suspended through the ctbrec REST API, which immediately stops
its recording and keeps it paused.  Allowlisted models keep recording, and an
allowlisted model that is paused is left paused.

When free space reaches the exit threshold, only the models suspended by this
tool are resumed.  Models the user had already paused before entering the mode
are never touched.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import logging
import os
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import requests
import urllib3

VERSION = "1.0.0"
GIB = 1024**3
DEFAULT_CONFIG = Path("/etc/ctbrec-disk-mode.json")
FALLBACK_STATE_DIR = Path("/var/lib/ctbrec-disk-mode")
LOG = logging.getLogger("ctbrec-disk-mode")


class ApiError(RuntimeError):
    """The ctbrec API returned an error or was unreachable."""


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def iso_to_local(value: str) -> str:
    """Best-effort display of a stored UTC timestamp."""
    try:
        dt = datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return dt.astimezone().strftime("%Y-%m-%d %H:%M")
    except (ValueError, TypeError):
        return value or "unknown"


def state_dir() -> Path:
    # systemd sets STATE_DIRECTORY when StateDirectory= is used.
    env = os.environ.get("STATE_DIRECTORY")
    if env:
        return Path(env.split(":")[0])
    return FALLBACK_STATE_DIR


def state_path() -> Path:
    return state_dir() / "state.json"


def load_config(path: Path) -> dict[str, Any]:
    try:
        cfg = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise SystemExit(f"config not found: {path}")
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid JSON in {path}: {exc}")

    for key in ("api_url", "enter_gib", "exit_gib", "allowlist"):
        if key not in cfg:
            raise SystemExit(f"{path}: missing required key {key!r}")

    if cfg["enter_gib"] <= 0 or cfg["exit_gib"] <= 0:
        raise SystemExit(f"{path}: enter_gib and exit_gib must be positive")
    if cfg["enter_gib"] >= cfg["exit_gib"]:
        raise SystemExit(f"{path}: enter_gib must be smaller than exit_gib")
    if not isinstance(cfg["allowlist"], list) or not cfg["allowlist"]:
        raise SystemExit(f"{path}: allowlist must be a non-empty list")

    cfg["allowlist"] = [str(x).strip() for x in cfg["allowlist"] if str(x).strip()]
    cfg.setdefault("hard_floor_gib", 1)
    cfg.setdefault("timeout", 60)
    return cfg


def load_state() -> dict[str, Any]:
    path = state_path()
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"active": False, "suspended_urls": []}
    except json.JSONDecodeError:
        LOG.warning("state file %s is corrupt; starting from inactive state", path)
        return {"active": False, "suspended_urls": []}


def _own_like_state_dir(path: Path) -> None:
    """Keep state files writable when a manual root run is followed by the timer."""
    try:
        stat = path.parent.stat()
        os.chown(path, stat.st_uid, stat.st_gid)
    except OSError:
        pass


def save_state(state: dict[str, Any]) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    state["updated_at"] = utcnow()
    fd, tmp = tempfile.mkstemp(prefix=".state.", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(tmp, 0o640)
        _own_like_state_dir(Path(tmp))
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def acquire_lock():
    lock_path = state_dir() / ".lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    handle = open(lock_path, "w")
    _own_like_state_dir(lock_path)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        LOG.info("another ctbrec-disk-mode run is in progress; exiting")
        raise SystemExit(0)
    return handle


class Client:
    def __init__(self, cfg: dict[str, Any]) -> None:
        self.base = str(cfg["api_url"]).rstrip("/")
        self.timeout = int(cfg["timeout"])
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
        self.session = requests.Session()
        self.session.verify = False
        self.session.headers.update({"X-Requested-With": "XMLHttpRequest"})

    def _request(self, method: str, path: str, payload: Any = None) -> Any:
        url = self.base + path
        last: Exception | None = None
        for attempt in range(1, 4):
            try:
                if method == "GET":
                    response = self.session.get(url, timeout=self.timeout)
                else:
                    response = self.session.post(
                        url, data=json.dumps(payload), timeout=self.timeout
                    )
                if response.status_code != 200:
                    raise ApiError(
                        f"{method} {path}: HTTP {response.status_code}: {response.text[:200]}"
                    )
                data = response.json()
                if isinstance(data, dict) and data.get("status") not in (None, "success"):
                    raise ApiError(
                        f"{method} {path}: {data.get('status')}: {data.get('msg', '')}"
                    )
                return data
            except (requests.RequestException, ValueError, ApiError) as exc:
                last = exc
                if attempt < 3:
                    LOG.warning("%s (attempt %d/3); retrying", exc, attempt)
                    time.sleep(2 * attempt)
        raise ApiError(str(last))

    def space(self) -> dict[str, Any]:
        return self._request("POST", "/rec", {"action": "space"})

    def models(self) -> list[dict[str, Any]]:
        return self._request("POST", "/rec", {"action": "list"})["models"]

    def suspend(self, model: dict[str, Any]) -> None:
        self._request("POST", "/rec", {"action": "suspend", "model": model})

    def resume(self, model: dict[str, Any]) -> None:
        self._request("POST", "/rec", {"action": "resume", "model": model})

    def settings(self) -> list[dict[str, Any]]:
        return self._request("GET", "/config")

    def update_settings(self, settings: list[dict[str, Any]]) -> None:
        self._request("POST", "/config", settings)


def allowlist_set(cfg: dict[str, Any]) -> set[str]:
    return {name.casefold() for name in cfg["allowlist"]}


def is_allowed(model: dict[str, Any], allowed: set[str]) -> bool:
    return (
        str(model.get("displayName", "")).casefold() in allowed
        or str(model.get("name", "")).casefold() in allowed
    )


def free_bytes(client: Client) -> int:
    return int(client.space()["spaceFree"])


def fmt_gib(value: int | float) -> str:
    return f"{value / GIB:.1f} GiB"


def enter_mode(
    client: Client,
    cfg: dict[str, Any],
    state: dict[str, Any],
    dry_run: bool,
) -> None:
    allowed = allowlist_set(cfg)
    models = client.models()
    targets = [
        m for m in models if not m.get("suspended", False) and not is_allowed(m, allowed)
    ]
    LOG.info(
        "entering low-space mode: %d active model(s) to suspend, %d allowlisted model(s) stay untouched",
        len(targets),
        sum(1 for m in models if is_allowed(m, allowed)),
    )
    if dry_run:
        for model in targets:
            LOG.info("dry-run: would suspend %s (%s)", model["displayName"], model["url"])
        return

    state.clear()
    state.update(
        {
            "active": True,
            "entered_at": utcnow(),
            "suspended_urls": [m["url"] for m in targets],
        }
    )
    save_state(state)

    failed: list[str] = []
    for index, model in enumerate(targets, start=1):
        try:
            client.suspend(model)
            LOG.info("suspended %s (%d/%d)", model["displayName"], index, len(targets))
        except ApiError as exc:
            failed.append(model["displayName"])
            LOG.error("could not suspend %s: %s", model["displayName"], exc)
    if failed:
        LOG.error("%d model(s) could not be suspended: %s", len(failed), ", ".join(failed))
        raise SystemExit(1)


def enforce_mode(client: Client, cfg: dict[str, Any], state: dict[str, Any], dry_run: bool) -> None:
    """Keep every non-allowlisted model suspended while the mode is active.

    An allowlisted model that this tool suspended earlier (for example a model
    added to the allowlist while the mode was already active) is resumed again,
    but only if this tool is the one that paused it.
    """
    allowed = allowlist_set(cfg)
    models = client.models()
    known = set(state.get("suspended_urls", []))

    for model in models:
        if (
            is_allowed(model, allowed)
            and model.get("suspended", False)
            and model["url"] in known
        ):
            if dry_run:
                LOG.info("dry-run: would resume allowlisted %s (%s)", model["displayName"], model["url"])
                continue
            try:
                client.resume(model)
                known.discard(model["url"])
                LOG.info("resumed allowlisted %s", model["displayName"])
            except ApiError as exc:
                LOG.error("could not resume allowlisted %s: %s", model["displayName"], exc)

    targets = [
        m for m in models if not m.get("suspended", False) and not is_allowed(m, allowed)
    ]
    if not targets:
        if not dry_run and known != set(state.get("suspended_urls", [])):
            state["suspended_urls"] = sorted(known)
            save_state(state)
        return
    LOG.info("low-space mode: re-suspending %d non-allowlisted model(s)", len(targets))
    if dry_run:
        for model in targets:
            LOG.info("dry-run: would suspend %s (%s)", model["displayName"], model["url"])
        return
    for model in targets:
        try:
            client.suspend(model)
            known.add(model["url"])
            LOG.info("suspended %s", model["displayName"])
        except ApiError as exc:
            LOG.error("could not suspend %s: %s", model["displayName"], exc)
    state["suspended_urls"] = sorted(known)
    save_state(state)


def exit_mode(
    client: Client,
    state: dict[str, Any],
    reason: str,
    dry_run: bool,
) -> None:
    urls = list(state.get("suspended_urls", []))
    LOG.info("leaving low-space mode (%s): %d model(s) to resume", reason, len(urls))
    if not urls:
        if not dry_run:
            state.clear()
            state.update({"active": False, "suspended_urls": []})
            save_state(state)
        return

    by_url = {m["url"]: m for m in client.models()}
    resumed = 0
    for url in urls:
        model = by_url.get(url)
        if model is None:
            LOG.warning("model no longer tracked: %s", url)
            continue
        if not model.get("suspended", False):
            LOG.info("not resuming %s: already active", model["displayName"])
            continue
        if dry_run:
            LOG.info("dry-run: would resume %s (%s)", model["displayName"], url)
            continue
        try:
            client.resume(model)
            resumed += 1
            LOG.info("resumed %s", model["displayName"])
        except ApiError as exc:
            LOG.error("could not resume %s: %s", model["displayName"], exc)

    if dry_run:
        return
    state.clear()
    state.update({"active": False, "suspended_urls": []})
    save_state(state)
    LOG.info("low-space mode off; resumed %d model(s)", resumed)


def ensure_floor(client: Client, cfg: dict[str, Any]) -> None:
    """Set ctbrec's own stop-everything reserve to hard_floor_gib."""
    target = int(round(float(cfg["hard_floor_gib"]) * GIB))
    settings = client.settings()
    entry = next(
        (s for s in settings if s.get("key") == "minimumSpaceLeftInBytes"), None
    )
    if entry is None:
        raise SystemExit("ctbrec settings do not contain minimumSpaceLeftInBytes")
    current = int(entry.get("value") or 0)
    if current == target:
        LOG.info("ctbrec hard floor already %s", fmt_gib(target))
        return
    entry["value"] = target
    client.update_settings(settings)
    LOG.info(
        "ctbrec hard floor changed from %s to %s",
        fmt_gib(current) if current else f"{current} bytes",
        fmt_gib(target),
    )


def cmd_status(client: Client, cfg: dict[str, Any], state: dict[str, Any]) -> None:
    space = client.space()
    free = int(space["spaceFree"])
    models = client.models()
    allowed = allowlist_set(cfg)
    matched = [m for m in models if is_allowed(m, allowed)]

    print(f"free space      {fmt_gib(free)} ({free} bytes)")
    print(f"enter threshold {fmt_gib(cfg['enter_gib'] * GIB)}")
    print(f"exit threshold  {fmt_gib(cfg['exit_gib'] * GIB)}")
    print(f"hard floor      {fmt_gib(int(space.get('minimumSpaceLeftInBytes') or 0))} (ctbrec minimumSpaceLeftInBytes)")
    print()
    if state.get("active"):
        print(f"mode            ACTIVE since {iso_to_local(state.get('entered_at', ''))}")
        print(f"suspended       {len(state.get('suspended_urls', []))} model(s) by this tool")
    else:
        print("mode            inactive")
        if free <= cfg["enter_gib"] * GIB:
            print("next run        WOULD ENTER low-space mode")
        elif free >= cfg["exit_gib"] * GIB:
            print("next run        stays inactive")
        else:
            print("next run        stays inactive (between thresholds)")
    print()

    names = {str(m.get("displayName", "")).casefold() for m in matched} | {
        str(m.get("name", "")).casefold() for m in matched
    }
    missing = sorted(name for name in cfg["allowlist"] if name.casefold() not in names)
    print(f"allowlist       {len(cfg['allowlist'])} name(s), {len(matched)} model(s) matched")
    for model in sorted(matched, key=lambda m: m["displayName"].casefold()):
        status = "paused" if model.get("suspended") else "active"
        print(f"  {model['displayName']:<24} {status:<7} {model['url']}")
    if missing:
        print(f"  NOT FOUND: {', '.join(missing)}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Strict low-disk allowlist mode for ctbrec.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG, help=f"config file (default: {DEFAULT_CONFIG})")
    parser.add_argument("--once", action="store_true", help="evaluate thresholds and act (default)")
    parser.add_argument("--status", action="store_true", help="show current state, no changes")
    parser.add_argument("--dry-run", action="store_true", help="with --once/--reset, only print intended actions")
    parser.add_argument("--reset", action="store_true", help="force low-space mode off (resume only models this tool suspended)")
    parser.add_argument("--ensure-floor", action="store_true", help="set ctbrec minimumSpaceLeftInBytes to hard_floor_gib and exit")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
        stream=sys.stderr,
    )

    cfg = load_config(args.config)

    if args.ensure_floor:
        ensure_floor(Client(cfg), cfg)
        return 0

    lock = acquire_lock()  # noqa: F841 - held until process exit
    client = Client(cfg)
    state = load_state()

    if args.status:
        cmd_status(client, cfg, state)
        return 0

    if args.reset:
        if not state.get("active"):
            print("low-space mode is not active; nothing to do")
            return 0
        exit_mode(client, state, "manual reset", args.dry_run)
        return 0

    free = free_bytes(client)
    enter_at = int(cfg["enter_gib"] * GIB)
    exit_at = int(cfg["exit_gib"] * GIB)
    LOG.info(
        "free %s (enter <= %s, exit >= %s); mode %s",
        fmt_gib(free),
        fmt_gib(enter_at),
        fmt_gib(exit_at),
        "active" if state.get("active") else "inactive",
    )

    if state.get("active"):
        if free >= exit_at:
            exit_mode(client, state, f"free {fmt_gib(free)} >= exit {fmt_gib(exit_at)}", args.dry_run)
        else:
            enforce_mode(client, cfg, state, args.dry_run)
    elif free <= enter_at:
        enter_mode(client, cfg, state, args.dry_run)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ApiError as exc:
        LOG.error("ctbrec API error: %s", exc)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
