#!/usr/bin/env python3
"""ctbrec-disk-mode - strict low-disk allowlist mode for ctbrec.

Runs inside the ctbrec LXC (proxmox VMID 109).  While free space on the
recordings filesystem is above the enter threshold every model records
normally.  At or below the enter threshold every model that is not on the
allowlist stops recording: models that are currently recording are suspended
through the ctbrec REST API in small, paced batches, which keeps them paused.
Allowlisted models keep recording, and an allowlisted model that is paused is
left paused.

Models that are not recording are never suspended - they are not using disk
and every suspend call takes ctbrec's recorder lock, so calling suspend for
hundreds of idle models is what previously wedged the recorder.

When a suspend or resume call fails or times out the run aborts immediately
and the tool backs off for a cooldown period, so a wedged recorder can never
accumulate a pile of blocked API calls.

When free space reaches the exit threshold, only the models suspended by this
tool are resumed.  Models the user had already paused before entering the mode
are never touched.

Forced mode (--on) keeps the allowlist enforced regardless of free space until
--off is given.  The marker file survives reboots, ctbrec restarts and timer
runs, so turning it off is an explicit act.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import logging
import os
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import requests
import urllib3

VERSION = "1.3.0"
GIB = 1024**3
DEFAULT_CONFIG = Path("/etc/ctbrec-disk-mode.json")
FALLBACK_STATE_DIR = Path("/var/lib/ctbrec-disk-mode")
LOG = logging.getLogger("ctbrec-disk-mode")

DEFAULT_HARD_FLOOR_GIB = 20
DEFAULT_TIMEOUT = 60
DEFAULT_ACTION_TIMEOUT_S = 15
DEFAULT_MAX_SUSPENDS_PER_RUN = 60
DEFAULT_MAX_RESUMES_PER_RUN = 60
DEFAULT_ACTION_DELAY_S = 0.2
DEFAULT_SLOW_ACTION_S = 5
DEFAULT_FAILURE_COOLDOWN_S = 600


class ApiError(RuntimeError):
    """The ctbrec API returned an error or was unreachable."""


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def epoch_to_utc(epoch: int | float) -> str:
    return datetime.fromtimestamp(float(epoch), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def iso_to_local(value: str) -> str:
    """Best-effort display of a stored UTC timestamp."""
    try:
        dt = datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return dt.astimezone().strftime("%Y-%m-%d %H:%M")
    except (ValueError, TypeError):
        return value or "unknown"


def fmt_duration(seconds: int | float) -> str:
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    minutes, rest = divmod(seconds, 60)
    if minutes < 60:
        return f"{minutes}m{rest:02d}s"
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h{minutes:02d}m"


def state_dir() -> Path:
    # systemd sets STATE_DIRECTORY when StateDirectory= is used.
    env = os.environ.get("STATE_DIRECTORY")
    if env:
        return Path(env.split(":")[0])
    return FALLBACK_STATE_DIR


def state_path() -> Path:
    return state_dir() / "state.json"


def force_marker() -> Path:
    return state_dir() / "forced"


def forced_on() -> bool:
    """Forced mode is on while the marker file exists."""
    return force_marker().exists()


def set_forced(enabled: bool) -> bool:
    """Create or remove the forced-mode marker. Returns True when it changed."""
    marker = force_marker()
    if enabled:
        if marker.exists():
            return False
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.touch()
        _own_like_state_dir(marker)
        return True
    if not marker.exists():
        return False
    marker.unlink()
    return True


def load_config(path: Path) -> dict[str, Any]:
    try:
        cfg = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise SystemExit(f"config not found: {path}")
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid JSON in {path}: {exc}")

    for key in ("api_url", "enter_gib", "exit_gib", "allowlist"):
        if key not in cfg:
            raise SystemExit(f"{path}: missing required key {key!r}")

    if cfg["enter_gib"] <= 0 or cfg["exit_gib"] <= 0:
        raise SystemExit(f"{path}: enter_gib and exit_gib must be positive")
    if cfg["enter_gib"] >= cfg["exit_gib"]:
        raise SystemExit(f"{path}: enter_gib must be smaller than exit_gib")
    if not isinstance(cfg["allowlist"], list) or not cfg["allowlist"]:
        raise SystemExit(f"{path}: allowlist must be a non-empty list")

    cfg["allowlist"] = [str(x).strip() for x in cfg["allowlist"] if str(x).strip()]
    cfg.setdefault("hard_floor_gib", DEFAULT_HARD_FLOOR_GIB)
    cfg.setdefault("timeout", DEFAULT_TIMEOUT)
    cfg.setdefault("action_timeout_s", DEFAULT_ACTION_TIMEOUT_S)
    cfg.setdefault("action_delay_s", DEFAULT_ACTION_DELAY_S)
    cfg.setdefault("slow_action_s", DEFAULT_SLOW_ACTION_S)
    cfg.setdefault("failure_cooldown_s", DEFAULT_FAILURE_COOLDOWN_S)

    # Older configs only had max_actions_per_run; honour it for both directions.
    shared_limit = cfg.get("max_actions_per_run")
    cfg.setdefault(
        "max_suspends_per_run",
        shared_limit if shared_limit is not None else DEFAULT_MAX_SUSPENDS_PER_RUN,
    )
    cfg.setdefault(
        "max_resumes_per_run",
        shared_limit if shared_limit is not None else DEFAULT_MAX_RESUMES_PER_RUN,
    )

    if int(cfg["max_suspends_per_run"]) < 1:
        raise SystemExit(f"{path}: max_suspends_per_run must be at least 1")
    if int(cfg["max_resumes_per_run"]) < 1:
        raise SystemExit(f"{path}: max_resumes_per_run must be at least 1")
    if float(cfg["action_timeout_s"]) <= 0:
        raise SystemExit(f"{path}: action_timeout_s must be positive")
    if float(cfg["action_delay_s"]) < 0:
        raise SystemExit(f"{path}: action_delay_s must not be negative")
    if float(cfg["slow_action_s"]) <= 0:
        raise SystemExit(f"{path}: slow_action_s must be positive")
    if int(cfg["failure_cooldown_s"]) < 0:
        raise SystemExit(f"{path}: failure_cooldown_s must not be negative")
    return cfg


def load_state() -> dict[str, Any]:
    path = state_path()
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"active": False, "suspended_urls": []}
    except json.JSONDecodeError:
        LOG.warning("state file %s is corrupt; starting from inactive state", path)
        return {"active": False, "suspended_urls": []}


def _own_like_state_dir(path: Path) -> None:
    """Keep state files writable when a manual root run is followed by the timer."""
    try:
        stat = path.parent.stat()
        os.chown(path, stat.st_uid, stat.st_gid)
    except OSError:
        pass


def save_state(state: dict[str, Any]) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    state["updated_at"] = utcnow()
    fd, tmp = tempfile.mkstemp(prefix=".state.", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(tmp, 0o640)
        _own_like_state_dir(Path(tmp))
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def acquire_lock():
    lock_path = state_dir() / ".lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    handle = open(lock_path, "w")
    _own_like_state_dir(lock_path)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        LOG.info("another ctbrec-disk-mode run is in progress; exiting")
        raise SystemExit(0)
    return handle


class Client:
    def __init__(self, cfg: dict[str, Any]) -> None:
        self.base = str(cfg["api_url"]).rstrip("/")
        self.timeout = int(cfg["timeout"])
        self.action_timeout = float(cfg["action_timeout_s"])
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
        self.session = requests.Session()
        self.session.verify = False
        self.session.headers.update({"X-Requested-With": "XMLHttpRequest"})

    def _request(
        self,
        method: str,
        path: str,
        payload: Any = None,
        *,
        timeout: float | None = None,
        attempts: int = 3,
    ) -> Any:
        url = self.base + path
        last: Exception | None = None
        attempts = max(1, attempts)
        for attempt in range(1, attempts + 1):
            try:
                if method == "GET":
                    response = self.session.get(
                        url, timeout=self.timeout if timeout is None else timeout
                    )
                else:
                    response = self.session.post(
                        url,
                        data=json.dumps(payload),
                        timeout=self.timeout if timeout is None else timeout,
                    )
                if response.status_code != 200:
                    raise ApiError(
                        f"{method} {path}: HTTP {response.status_code}: {response.text[:200]}"
                    )
                data = response.json()
                if isinstance(data, dict) and data.get("status") not in (None, "success"):
                    raise ApiError(
                        f"{method} {path}: {data.get('status')}: {data.get('msg', '')}"
                    )
                return data
            except (requests.RequestException, ValueError, ApiError) as exc:
                last = exc
                if attempt < attempts:
                    LOG.warning("%s (attempt %d/%d); retrying", exc, attempt, attempts)
                    time.sleep(2 * attempt)
        raise ApiError(str(last))

    def space(self) -> dict[str, Any]:
        return self._request("POST", "/rec", {"action": "space"}, attempts=2)

    def models(self) -> list[dict[str, Any]]:
        return self._request("POST", "/rec", {"action": "list"}, attempts=2)["models"]

    def recording_models(self) -> list[dict[str, Any]]:
        return self._request(
            "POST", "/rec", {"action": "listCurrentlyRecording"}, attempts=2
        )["models"]

    def suspend(self, model: dict[str, Any]) -> None:
        # One attempt only: a timed-out suspend leaves a blocked request thread
        # behind, so retrying multiplies the damage if the recorder is wedged.
        self._request(
            "POST",
            "/rec",
            {"action": "suspend", "model": model},
            timeout=self.action_timeout,
            attempts=1,
        )

    def resume(self, model: dict[str, Any]) -> None:
        self._request(
            "POST",
            "/rec",
            {"action": "resume", "model": model},
            timeout=self.action_timeout,
            attempts=1,
        )

    def settings(self) -> list[dict[str, Any]]:
        return self._request("GET", "/config")

    def update_settings(self, settings: list[dict[str, Any]]) -> None:
        self._request("POST", "/config", settings, attempts=2)


def allowlist_set(cfg: dict[str, Any]) -> set[str]:
    return {name.casefold() for name in cfg["allowlist"]}


def is_allowed(model: dict[str, Any], allowed: set[str]) -> bool:
    return (
        str(model.get("displayName", "")).casefold() in allowed
        or str(model.get("name", "")).casefold() in allowed
    )


def model_label(model: dict[str, Any]) -> str:
    return str(model.get("displayName") or model.get("name") or model.get("url") or "?")


def free_bytes(client: Client) -> int:
    return int(client.space()["spaceFree"])


def fmt_gib(value: int | float) -> str:
    return f"{value / GIB:.1f} GiB"


def suspended_urls(state: dict[str, Any]) -> set[str]:
    return set(str(url) for url in state.get("suspended_urls") or [])


def add_suspended(state: dict[str, Any], url: str) -> None:
    urls = suspended_urls(state)
    urls.add(url)
    state["suspended_urls"] = sorted(urls)


def drop_suspended(state: dict[str, Any], url: str) -> None:
    urls = suspended_urls(state)
    urls.discard(url)
    state["suspended_urls"] = sorted(urls)


def cooldown_remaining(state: dict[str, Any]) -> int:
    failure = state.get("failure") or {}
    retry_after = failure.get("retry_after_epoch")
    if not retry_after:
        return 0
    return max(0, int(retry_after) - int(time.time()))


def record_failure(
    cfg: dict[str, Any],
    state: dict[str, Any],
    model: dict[str, Any],
    exc: Exception,
) -> None:
    """Remember a failed recorder action and back off for a while.

    A suspended/blocked recorder action is the signature of the ctbrec
    stop-recording deadlock, so the next run must not immediately add another
    blocked request to the pile.
    """
    cooldown = int(cfg["failure_cooldown_s"])
    retry_after = int(time.time()) + cooldown
    state["failure"] = {
        "at": utcnow(),
        "model": model_label(model),
        "url": str(model.get("url", "")),
        "error": str(exc)[:500],
        "retry_after_epoch": retry_after,
        "retry_after": epoch_to_utc(retry_after),
    }
    save_state(state)
    LOG.error(
        "recorder action failed for %s: %s", model_label(model), exc
    )
    if cooldown:
        LOG.error(
            "aborting this run and pausing recorder actions for %s (until %s); "
            "if free space keeps dropping the ctbrec recorder is probably wedged "
            "and ctbrec.service needs a restart",
            fmt_duration(cooldown),
            iso_to_local(epoch_to_utc(retry_after)),
        )


def clear_failure(state: dict[str, Any]) -> None:
    if state.pop("failure", None) is not None:
        save_state(state)


def suspend_recording_models(
    client: Client,
    cfg: dict[str, Any],
    state: dict[str, Any],
    dry_run: bool,
) -> tuple[int, int]:
    """Suspend non-allowlisted models that are recording right now.

    Returns (suspended this run, still left to suspend).
    """
    allowed = allowlist_set(cfg)
    targets = [
        model for model in client.recording_models() if not is_allowed(model, allowed)
    ]
    if not targets:
        LOG.info("no non-allowlisted model is recording; nothing to suspend")
        return 0, 0

    limit = int(cfg["max_suspends_per_run"])
    batch = targets if dry_run else targets[:limit]
    LOG.info(
        "low-space mode: %d non-allowlisted model(s) recording, suspending %d now (max %d per run)",
        len(targets),
        len(batch),
        limit,
    )

    suspended = 0
    for index, model in enumerate(batch, start=1):
        if dry_run:
            LOG.info("dry-run: would suspend %s (%s)", model_label(model), model.get("url"))
            continue
        try:
            started = time.monotonic()
            client.suspend(model)
            elapsed = time.monotonic() - started
        except ApiError as exc:
            record_failure(cfg, state, model, exc)
            return suspended, len(targets) - suspended
        add_suspended(state, str(model["url"]))
        clear_failure(state)
        save_state(state)
        suspended += 1
        LOG.info(
            "suspended %s (%d/%d now, %d left for later runs)",
            model_label(model),
            suspended,
            len(batch),
            len(targets) - suspended,
        )
        if elapsed > float(cfg["slow_action_s"]):
            LOG.warning(
                "suspend of %s took %.1fs; stopping this batch so a struggling recorder is not hammered",
                model_label(model),
                elapsed,
            )
            return suspended, len(targets) - suspended
        if index < len(batch) and float(cfg["action_delay_s"]) > 0:
            time.sleep(float(cfg["action_delay_s"]))
    return suspended, len(targets) - suspended


def resume_batch(
    client: Client,
    cfg: dict[str, Any],
    state: dict[str, Any],
    *,
    only_allowed: bool,
    dry_run: bool,
) -> tuple[int, int, bool]:
    """Resume models this tool suspended, in paced batches.

    only_allowed=True takes allowlisted models back out of suspension (used
    while the mode stays active and the allowlist changed), False resumes
    everything this tool suspended (used when leaving the mode).

    Returns (resumed this run, still suspended, failed).
    """
    allowed = allowlist_set(cfg)
    urls = sorted(suspended_urls(state))
    if not urls:
        return 0, 0, False

    by_url = {str(model["url"]): model for model in client.models()}
    limit = int(cfg["max_resumes_per_run"])
    attempted = 0
    resumed = 0

    for url in urls:
        if attempted >= limit:
            break
        model = by_url.get(url)
        if model is None or not model.get("suspended", False):
            # Gone from the model list or already active: forget it. While the
            # mode stays active other models' entries must be left alone.
            if not only_allowed and not dry_run:
                drop_suspended(state, url)
                save_state(state)
            continue
        if only_allowed and not is_allowed(model, allowed):
            continue
        if dry_run:
            LOG.info("dry-run: would resume %s (%s)", model_label(model), url)
            attempted += 1
            continue
        attempted += 1
        try:
            started = time.monotonic()
            client.resume(model)
            elapsed = time.monotonic() - started
        except ApiError as exc:
            record_failure(cfg, state, model, exc)
            return resumed, len(suspended_urls(state)), True
        drop_suspended(state, url)
        clear_failure(state)
        save_state(state)
        resumed += 1
        LOG.info("resumed %s", model_label(model))
        if elapsed > float(cfg["slow_action_s"]):
            LOG.warning(
                "resume of %s took %.1fs; stopping this batch so a struggling recorder is not hammered",
                model_label(model),
                elapsed,
            )
            return resumed, len(suspended_urls(state)), False
        if attempted < limit and float(cfg["action_delay_s"]) > 0:
            time.sleep(float(cfg["action_delay_s"]))

    return resumed, len(suspended_urls(state)), False


def enter_mode(
    client: Client,
    cfg: dict[str, Any],
    state: dict[str, Any],
    dry_run: bool,
    reason: str = "low disk space",
) -> None:
    allowed = allowlist_set(cfg)
    recording = client.recording_models()
    targets = [model for model in recording if not is_allowed(model, allowed)]
    LOG.info(
        "entering mode (%s): %d non-allowlisted model(s) recording, "
        "%d allowlisted model(s) stay untouched",
        reason,
        len(targets),
        sum(1 for model in recording if is_allowed(model, allowed)),
    )
    if dry_run:
        suspend_recording_models(client, cfg, state, dry_run=True)
        return

    state.clear()
    state.update({"active": True, "entered_at": utcnow(), "suspended_urls": []})
    save_state(state)

    suspended, remaining = suspend_recording_models(client, cfg, state, dry_run=False)
    if remaining:
        LOG.info(
            "%d recording model(s) still to suspend on later runs", remaining
        )


def enforce_mode(
    client: Client,
    cfg: dict[str, Any],
    state: dict[str, Any],
    dry_run: bool,
) -> None:
    """Keep every non-allowlisted recording model suspended while active.

    An allowlisted model that this tool suspended earlier (for example a model
    added to the allowlist while the mode was already active) is resumed again,
    but only if this tool is the one that paused it.
    """
    resumed, _, failed = resume_batch(
        client, cfg, state, only_allowed=True, dry_run=dry_run
    )
    if failed:
        return
    if resumed:
        LOG.info("resumed %d allowlisted model(s)", resumed)
    suspend_recording_models(client, cfg, state, dry_run=dry_run)


def exit_mode(
    client: Client,
    cfg: dict[str, Any],
    state: dict[str, Any],
    reason: str,
    dry_run: bool,
) -> None:
    urls = suspended_urls(state)
    LOG.info("leaving low-space mode (%s): %d model(s) to resume", reason, len(urls))
    if not urls:
        if not dry_run:
            state.clear()
            state.update({"active": False, "suspended_urls": []})
            save_state(state)
            LOG.info("low-space mode off")
        return

    # Latch the exit: once draining has started it must finish even if free
    # space falls back between the thresholds while the models resume. Without
    # the latch a batched exit would flap around the exit threshold forever.
    if not dry_run and not state.get("exiting"):
        state["exiting"] = True
        save_state(state)

    resumed, remaining, failed = resume_batch(
        client, cfg, state, only_allowed=False, dry_run=dry_run
    )
    if dry_run:
        return
    if failed or remaining:
        if remaining:
            LOG.info(
                "resumed %d model(s) this run; %d still suspended, continuing on later runs",
                resumed,
                remaining,
            )
        return
    state.clear()
    state.update({"active": False, "suspended_urls": []})
    save_state(state)
    LOG.info("low-space mode off; all models it suspended are recording again")


def ensure_floor(client: Client, cfg: dict[str, Any]) -> None:
    """Set ctbrec's own stop-everything reserve to hard_floor_gib."""
    target = int(round(float(cfg["hard_floor_gib"]) * GIB))
    settings = client.settings()
    entry = next(
        (s for s in settings if s.get("key") == "minimumSpaceLeftInBytes"), None
    )
    if entry is None:
        raise SystemExit("ctbrec settings do not contain minimumSpaceLeftInBytes")
    current = int(entry.get("value") or 0)
    if current == target:
        LOG.info("ctbrec hard floor already %s", fmt_gib(target))
        return
    entry["value"] = target
    client.update_settings(settings)
    LOG.info(
        "ctbrec hard floor changed from %s to %s",
        fmt_gib(current) if current else f"{current} bytes",
        fmt_gib(target),
    )


def cmd_status(client: Client, cfg: dict[str, Any], state: dict[str, Any]) -> None:
    space = client.space()
    free = int(space["spaceFree"])
    models = client.models()
    recording = client.recording_models()
    allowed = allowlist_set(cfg)
    matched = [model for model in models if is_allowed(model, allowed)]
    known = suspended_urls(state)
    actually_suspended = [
        model for model in models if model.get("suspended") and model["url"] in known
    ]
    forced = forced_on()

    print(f"free space      {fmt_gib(free)} ({free} bytes)")
    print(f"enter threshold {fmt_gib(cfg['enter_gib'] * GIB)}")
    print(f"exit threshold  {fmt_gib(cfg['exit_gib'] * GIB)}")
    print(f"hard floor      {fmt_gib(int(space.get('minimumSpaceLeftInBytes') or 0))} (ctbrec minimumSpaceLeftInBytes)")
    if forced:
        print("forced          ON (allowlist enforced regardless of free space)")
    else:
        print("forced          off")
    print()
    if state.get("active"):
        suffix = " [finishing exit]" if state.get("exiting") else ""
        if forced:
            suffix += " [forced]"
        print(f"mode            ACTIVE since {iso_to_local(state.get('entered_at', ''))}{suffix}")
        print(
            f"suspended       {len(actually_suspended)} model(s) by this tool "
            f"({len(known)} tracked in state)"
        )
    else:
        print("mode            inactive")
        if forced:
            print("next run        WOULD ENTER the mode (forced on)")
        elif free <= cfg["enter_gib"] * GIB:
            print("next run        WOULD ENTER low-space mode")
        elif free >= cfg["exit_gib"] * GIB:
            print("next run        stays inactive")
        else:
            print("next run        stays inactive (between thresholds)")

    remaining = cooldown_remaining(state)
    failure = state.get("failure") or {}
    if remaining:
        print(
            f"backing off     {fmt_duration(remaining)} after a failed action on "
            f"{failure.get('model', '?')} at {iso_to_local(failure.get('at', ''))}"
        )
        print(f"  error: {failure.get('error', '')}")
    print(f"recording now   {len(recording)} model(s)")
    print()

    names = {str(m.get("displayName", "")).casefold() for m in matched} | {
        str(m.get("name", "")).casefold() for m in matched
    }
    missing = sorted(name for name in cfg["allowlist"] if name.casefold() not in names)
    print(f"allowlist       {len(cfg['allowlist'])} name(s), {len(matched)} model(s) matched")
    for model in sorted(matched, key=lambda m: m["displayName"].casefold()):
        status = "paused" if model.get("suspended") else "active"
        print(f"  {model['displayName']:<24} {status:<7} {model['url']}")
    if missing:
        print(f"  NOT FOUND: {', '.join(missing)}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Strict low-disk allowlist mode for ctbrec.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG, help=f"config file (default: {DEFAULT_CONFIG})")
    parser.add_argument("--once", action="store_true", help="evaluate thresholds and act (default)")
    parser.add_argument("--status", action="store_true", help="show current state, no changes")
    parser.add_argument("--dry-run", action="store_true", help="with --once/--reset, only print intended actions")
    parser.add_argument("--reset", action="store_true", help="force low-space mode off (resume only models this tool suspended)")
    parser.add_argument("--on", action="store_true", help="force the allowlist on regardless of free space, until --off")
    parser.add_argument("--off", action="store_true", help="leave forced mode and the allowlist mode, resuming the models this tool suspended")
    parser.add_argument("--ensure-floor", action="store_true", help="set ctbrec minimumSpaceLeftInBytes to hard_floor_gib and exit")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
        stream=sys.stderr,
    )

    cfg = load_config(args.config)

    if args.ensure_floor:
        ensure_floor(Client(cfg), cfg)
        return 0

    lock = acquire_lock()  # noqa: F841 - held until process exit
    client = Client(cfg)
    state = load_state()

    if args.status:
        cmd_status(client, cfg, state)
        return 0

    if args.reset:
        if not state.get("active"):
            print("low-space mode is not active; nothing to do")
            if forced_on():
                LOG.warning("forced mode is still on; run --off to keep the mode off")
            return 0
        exit_mode(client, cfg, state, "manual reset", args.dry_run)
        if forced_on():
            LOG.warning(
                "forced mode is still on; the next run re-enters the mode (use --off to turn it off)"
            )
        return 0

    if args.on:
        if args.dry_run:
            LOG.info("dry-run: would turn forced mode on")
        elif set_forced(True):
            LOG.info("forced mode on: the allowlist is enforced regardless of free space")
        else:
            LOG.info("forced mode already on")
        if args.dry_run:
            return 0

    if args.off:
        if args.dry_run:
            LOG.info("dry-run: would turn forced mode off and leave the mode")
            return 0
        if set_forced(False):
            LOG.info("forced mode off: the disk thresholds apply again")
        else:
            LOG.info("forced mode was not on")
        if not state.get("active"):
            print("the mode is not active; nothing to resume")
            return 0
        exit_mode(client, cfg, state, "forced mode turned off", args.dry_run)
        return 0

    free = free_bytes(client)
    forced = forced_on()
    enter_at = int(cfg["enter_gib"] * GIB)
    exit_at = int(cfg["exit_gib"] * GIB)
    LOG.info(
        "free %s (enter <= %s, exit >= %s); mode %s%s",
        fmt_gib(free),
        fmt_gib(enter_at),
        fmt_gib(exit_at),
        "active" if state.get("active") else "inactive",
        ", forced" if forced else "",
    )

    remaining = cooldown_remaining(state)
    if remaining and not args.dry_run:
        failure = state.get("failure") or {}
        LOG.warning(
            "backing off %s after a failed action on %s at %s (%s); no recorder actions this run",
            fmt_duration(remaining),
            failure.get("model", "?"),
            iso_to_local(failure.get("at", "")),
            failure.get("error", ""),
        )
        return 0
    if remaining == 0 and state.get("failure"):
        LOG.info("cooldown expired; retrying recorder actions")
        state.pop("failure", None)
        save_state(state)

    if forced:
        # Forced mode: the allowlist is the only rule, thresholds are ignored.
        if state.get("active"):
            if state.get("exiting"):
                exit_mode(client, cfg, state, "finishing exit", args.dry_run)
            else:
                enforce_mode(client, cfg, state, args.dry_run)
        else:
            enter_mode(client, cfg, state, args.dry_run, reason="forced mode")
        return 0

    if state.get("active"):
        if state.get("exiting") or free >= exit_at:
            reason = (
                "finishing exit"
                if state.get("exiting")
                else f"free {fmt_gib(free)} >= exit {fmt_gib(exit_at)}"
            )
            exit_mode(client, cfg, state, reason, args.dry_run)
        else:
            enforce_mode(client, cfg, state, args.dry_run)
    elif free <= enter_at:
        enter_mode(client, cfg, state, args.dry_run)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ApiError as exc:
        LOG.error("ctbrec API error: %s", exc)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
