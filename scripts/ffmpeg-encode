#!/usr/bin/env python3
"""Batch VAAPI encoder (HEVC or AV1) with curses TUI — pause, resume, live queue.

Both codecs use constant-quality mode: HEVC via -qp (0-51), AV1 via VAAPI
CQP -global_quality (0-255).  Select the codec with --codec hevc|av1 (the
ffmpeg-encode-av1 wrapper passes --codec av1).

--vr switches to a conservative quality default suited to stereoscopic
VR180/VR360 captures (which arrive already heavily compressed as one
side-by-side HEVC frame) and refuses to shrink the frame: the encoded
output must keep the source's exact pixel dimensions or the job fails.  VR
outputs are written under a VR/ subdirectory of the output root."""

import argparse
import curses
import os
import pathlib
import signal
import subprocess
import sys
import threading
import time
from dataclasses import dataclass, field
from typing import List, Optional, Tuple

# ═══════════════════════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════════════════════

EXTENSIONS = ("mkv", "mp4", "avi", "mov", "webm", "ts", "mts", "webp")
HWACCEL = "vaapi"
DEFAULT_INPUT_DIR = "/mnt/shared/Compressing"
DEFAULT_OUTPUT_DIR = "/mnt/shared/Handbraked"
DEFAULT_PRESET = "balanced"
DEFAULT_CODEC = "hevc"
# --vr writes its outputs into this subdirectory of the output root, so VR
# captures are kept separate from the normal Handbraked tree.
VR_SUBDIR = "VR"

# Per-codec settings.  Both encoders run in constant-quality mode: HEVC via
# its native -qp (0-51), AV1 via VAAPI CQP -global_quality (0-255, roughly
# 4x the HEVC QP).  The quality scale differs per codec, so the default and
# the meaning of -q change with --codec.
CODECS = {
    "hevc": {
        "encoder": "hevc_vaapi",
        "quality_min": 0,
        "quality_max": 51,
        "default_quality": 27,
        "vr_quality": 30,
    },
    "av1": {
        "encoder": "av1_vaapi",
        "quality_min": 0,
        "quality_max": 255,
        "default_quality": 97,
        "vr_quality": 130,
    },
}

# --vr quality defaults.  Stereoscopic captures are delivered almost at a
# "baked" bitrate, so the normal default (HEVC QP 27) can re-encode *larger*
# than the source and be discarded as "kept".  The VR defaults sit at the
# conservative end of the range that still produces a real saving while
# staying visually close to the source; an explicit -q still overrides them.

# VAAPI exposes no quality preset; -async_depth only trades parallelism for
# speed (higher = faster, no effect on quality).  Keep the old preset names
# as a speed control.
PRESET_ASYNC = {"speed": 8, "balanced": 4, "quality": 2}

# ═══════════════════════════════════════════════════════════════════════
# Data
# ═══════════════════════════════════════════════════════════════════════

@dataclass
class Job:
    input_path: str
    output_path: str
    status: str = "pending"
    input_size: int = 0
    output_size: int = 0
    duration: float = 0.0
    error: str = ""
    progress: int = 0
    fps: float = 0.0
    ous: int = 0
    start: float = 0.0
    paused_accum: float = 0.0
    cancel: bool = False

    @property
    def basename(self) -> str:
        return os.path.basename(self.input_path)

@dataclass
class SharedState:
    lock: threading.Lock = field(default_factory=threading.Lock)
    status: str = "idle"
    ffmpeg_pids: set = field(default_factory=set)
    active: int = 0
    quit: bool = False
    total_in_bytes: int = 0
    total_out_bytes: int = 0
    workers: list = field(default_factory=list)

# ═══════════════════════════════════════════════════════════════════════
# Utilities
# ═══════════════════════════════════════════════════════════════════════

def human_bytes(n: int) -> str:
    if n < 0:
        return "-" + human_bytes(-n)
    if n == 0:
        return "0 B"
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    for unit in units:
        if abs(n) < 1024:
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024
    return f"{n:.1f} PiB"

def fmt_duration(seconds: float) -> str:
    seconds = max(0.0, seconds)
    return (f"{int(seconds // 3600):02d}:"
            f"{int((seconds % 3600) // 60):02d}:"
            f"{int(seconds % 60):02d}")

def get_duration(path: str) -> float:
    try:
        r = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "default=noprint_wrappers=1:nokey=1", path],
            capture_output=True, text=True, timeout=30,
        )
        return float(r.stdout.strip() or 0)
    except Exception:
        return 0.0

def get_dimensions(path: str) -> Optional[Tuple[int, int]]:
    """Return (width, height) of the first video stream, or None."""
    try:
        r = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height",
             "-of", "csv=p=0:s=x", path],
            capture_output=True, text=True, timeout=30,
        )
        w, h = r.stdout.strip().split("x")[:2]
        return int(w), int(h)
    except Exception:
        return None

def collect_files(directory: str) -> List[str]:
    root = pathlib.Path(directory)
    if not root.is_dir():
        return []
    exts = {f".{e}" for e in EXTENSIONS}
    return sorted(
        str(p) for p in root.rglob("*")
        if p.is_file() and p.suffix.lower() in exts
    )

def collect_all(directories: List[str]) -> List[str]:
    seen = set()
    files: List[str] = []
    for directory in directories:
        for f in collect_files(directory):
            if f not in seen:
                seen.add(f)
                files.append(f)
    return files

def check_vaapi() -> bool:
    try:
        r = subprocess.run(
            ["ffmpeg", "-hide_banner", "-hwaccels"],
            capture_output=True, text=True, timeout=10,
        )
        return "vaapi" in r.stdout
    except Exception:
        return False

# ═══════════════════════════════════════════════════════════════════════
# Queue
# ═══════════════════════════════════════════════════════════════════════

class Queue:
    def __init__(self, input_dirs: List[str], output_dir: str):
        self.input_dirs = list(input_dirs)
        self.output_dir = output_dir
        self.jobs: List[Job] = []

    def add_file(self, path: str) -> Optional[Job]:
        p = pathlib.Path(path)
        if not p.is_file():
            return None

        rel = p.name
        for root in self.input_dirs:
            try:
                rel = str(p.relative_to(root))
                break
            except ValueError:
                continue

        output_path = str(pathlib.Path(self.output_dir) / rel)
        output_path = str(pathlib.Path(output_path).with_suffix(".mkv"))

        job = Job(
            input_path=str(p),
            output_path=output_path,
            input_size=os.path.getsize(str(p)),
            duration=get_duration(str(p)),
        )
        self.jobs.append(job)
        return job

    @property
    def pending(self) -> List[Job]:
        return [j for j in self.jobs if j.status == "pending"]

    @property
    def stats(self):
        done = sum(1 for j in self.jobs if j.status == "done")
        failed = sum(1 for j in self.jobs if j.status == "failed")
        skipped = sum(1 for j in self.jobs if j.status == "skipped")
        kept = sum(1 for j in self.jobs if j.status == "kept")
        total_in = sum(j.input_size for j in self.jobs if j.status in ("done", "failed"))
        total_out = sum(j.output_size for j in self.jobs if j.status == "done")
        return done, failed, skipped, kept, total_in, total_out

# ═══════════════════════════════════════════════════════════════════════
# Worker thread
# ═══════════════════════════════════════════════════════════════════════

def find_vaapi_device() -> str:
    for p in sorted(pathlib.Path("/dev/dri").glob("renderD*")):
        return str(p)
    for p in sorted(pathlib.Path("/dev/dri").glob("card*")):
        return str(p)
    return "/dev/dri/renderD128"

def _hw_decode_failed(stderr_text: str) -> bool:
    markers = ("Failed setup for format vaapi",
               "No support for codec",
               "hwaccel initialisation returned error",
               "Impossible to convert")
    return any(m in stderr_text for m in markers)

def _audio_mux_failed(stderr_text: str) -> bool:
    # Corrupt/unparseable ADTS AAC (common in MPEG-TS captures) makes the
    # Matroska muxer abort when the audio is stream-copied.  Re-encode it.
    markers = ("Error parsing AAC extradata",
               "unable to determine samplerate")
    return any(m in stderr_text for m in markers)

def _rate_control_args(codec: str, preset: str, quality: int) -> List[str]:
    cfg = CODECS[codec]
    args = ["-c:v", cfg["encoder"]]
    if codec == "hevc":
        args += ["-b:v", "0", "-qp", str(quality)]
    else:
        args += ["-rc_mode", "CQP", "-global_quality", str(quality)]
    args += ["-async_depth", str(PRESET_ASYNC[preset])]
    return args

def _audio_args(copy_audio: bool) -> List[str]:
    if copy_audio:
        return ["-c:a", "copy"]
    return ["-c:a", "aac", "-b:a", "160k"]

def _build_ffmpeg_cmd(job: Job, codec: str, preset: str, quality: int,
                      device: str, copy_audio: bool = True,
                      sw_decode: bool = False) -> List[str]:
    # sw_decode: software decode + hwupload for streams the VAAPI decoder
    # can't initialise on (e.g. malformed 4K SPS); the GPU still encodes.
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error",
        "-progress", "pipe:1", "-nostats",
        "-vaapi_device", device,
    ]
    if not sw_decode:
        cmd.extend(["-hwaccel", HWACCEL, "-hwaccel_output_format", HWACCEL])
    cmd.extend(["-i", job.input_path])
    if sw_decode:
        cmd.extend(["-vf", "format=nv12,hwupload"])
    cmd.extend(_rate_control_args(codec, preset, quality))
    cmd.extend(_audio_args(copy_audio))
    cmd.extend(["-map", "0:v?", "-map", "0:a?"])
    cmd.extend(["-y", job.output_path])
    return cmd

def _kill_process(pid: int, sig: int):
    try:
        os.killpg(os.getpgid(pid), sig)
    except OSError:
        try:
            os.kill(pid, sig)
        except OSError:
            pass

def _run_ffmpeg(cmd: List[str], job: Job, state: SharedState) -> Tuple[int, str]:
    """Run one ffmpeg encode to completion. Returns (returncode, stderr_text)."""
    os.makedirs(os.path.dirname(job.output_path), exist_ok=True)

    with state.lock:
        if state.quit or job.cancel:
            job.status = "skipped"
            return -1, ""

    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1, start_new_session=True,
    )

    with state.lock:
        state.ffmpeg_pids.add(proc.pid)

    # Quit/cancel may have landed while the process was starting: kill it
    # before it can produce output.
    with state.lock:
        cancelled = state.quit or job.cancel
    if cancelled:
        _kill_process(proc.pid, signal.SIGKILL)
        proc.wait()
        with state.lock:
            state.ffmpeg_pids.discard(proc.pid)
        job.status = "skipped"
        return -1, ""

    with state.lock:
        state.status = "encoding"
        job.status = "encoding"
        job.progress = 0
        job.fps = 0.0
        job.ous = 0

    stderr_lines: List[str] = []
    def _drain_stderr():
        for line in proc.stderr:
            stderr_lines.append(line)
    drain = threading.Thread(target=_drain_stderr, daemon=True)
    drain.start()

    out_time_us = 0
    duration = job.duration or get_duration(job.input_path)

    try:
        for line in proc.stdout:
            if "=" not in line:
                continue
            key, _, value = line.strip().partition("=")

            if key == "out_time_us":
                try:
                    out_time_us = int(value)
                    with state.lock:
                        job.ous = out_time_us
                except ValueError:
                    pass
            elif key == "fps":
                try:
                    with state.lock:
                        job.fps = float(value)
                except ValueError:
                    pass
            elif key == "progress":
                if duration > 0:
                    pct = min(100, max(0,
                        int((out_time_us / 1_000_000) / duration * 100 + 0.5)))
                    with state.lock:
                        job.progress = pct
                if value == "end":
                    break

        proc.wait()
        drain.join()
        return proc.returncode, "".join(stderr_lines)
    finally:
        with state.lock:
            state.ffmpeg_pids.discard(proc.pid)

def ffmpeg_worker(job: Job, state: SharedState, codec: str, preset: str,
                  quality: int, delete_original: bool, vr: bool = False):
    device = find_vaapi_device()
    sw_decode = False
    copy_audio = True

    def cancelled() -> bool:
        with state.lock:
            return state.quit or job.cancel

    def attempt() -> Tuple[int, str]:
        return _run_ffmpeg(
            _build_ffmpeg_cmd(job, codec, preset, quality, device,
                              copy_audio, sw_decode), job, state)

    try:
        returncode, stderr_text = attempt()

        # VAAPI decode failed (e.g. malformed 4K H.264 SPS the hw decoder
        # refuses): retry once with software decode + hwupload so the GPU
        # still does the encode.
        if not cancelled() and returncode != 0 and _hw_decode_failed(stderr_text):
            sw_decode = True
            returncode, stderr_text = attempt()

        # Muxing a stream-copied ADTS AAC into Matroska can fail on corrupt
        # captures: retry once with the audio re-encoded as AAC.
        if not cancelled() and returncode != 0 and _audio_mux_failed(stderr_text):
            copy_audio = False
            returncode, stderr_text = attempt()

        with state.lock:
            if state.quit or job.cancel:
                job.status = "skipped"
                if os.path.exists(job.output_path):
                    try:
                        os.remove(job.output_path)
                    except OSError:
                        pass
            elif returncode == 0 and os.path.getsize(job.output_path) > 0:
                out_size = os.path.getsize(job.output_path)
                # VR: never accept a downscaled/re-cropped frame.  The two
                # fisheye eyes must survive at their source resolution.
                dims_changed = ""
                if vr:
                    din = get_dimensions(job.input_path)
                    dout = get_dimensions(job.output_path)
                    if din and dout and din != dout:
                        dims_changed = f"{din[0]}x{din[1]} -> {dout[0]}x{dout[1]}"
                if dims_changed:
                    job.status = "failed"
                    job.error = f"VR resolution changed: {dims_changed}"
                    try:
                        os.remove(job.output_path)
                    except OSError:
                        pass
                elif out_size < job.input_size:
                    job.status = "done"
                    job.output_size = out_size
                    job.progress = 100
                    state.total_in_bytes += job.input_size
                    state.total_out_bytes += out_size
                    if delete_original:
                        try:
                            os.remove(job.input_path)
                        except OSError:
                            pass
                elif delete_original:
                    # Encode is not smaller — discard it, keep the original
                    job.status = "kept"
                    try:
                        os.remove(job.output_path)
                    except OSError:
                        pass
                else:
                    # -k mode: keep both, record as done
                    job.status = "done"
                    job.output_size = out_size
                    job.progress = 100
                    state.total_in_bytes += job.input_size
                    state.total_out_bytes += out_size
            else:
                job.status = "failed"
                if returncode != 0:
                    job.error = stderr_text[:300] if stderr_text else f"exit {returncode}"
                else:
                    job.error = "output file empty"
                if os.path.exists(job.output_path) and os.path.getsize(job.output_path) == 0:
                    try:
                        os.remove(job.output_path)
                    except OSError:
                        pass

    except Exception as exc:
        job.status = "failed"
        job.error = str(exc)
    finally:
        with state.lock:
            state.active = max(0, state.active - 1)
            if state.active == 0:
                state.status = "idle"

# ═══════════════════════════════════════════════════════════════════════
# Curses TUI
# ═══════════════════════════════════════════════════════════════════════

_BAR_FILL   = "█"
_BAR_EMPTY  = "░"

class TUI:
    def __init__(self, stdscr, queue: Queue, state: SharedState, args):
        self.stdscr = stdscr
        self.queue = queue
        self.state = state
        self.args = args
        self.start_time = time.time()
        self.total_paused = 0.0
        self.pause_start = 0.0

        # smooth-speed tracking
        self._prev_ous = 0
        self._prev_active = 0.0
        self._smooth_speed = 0.0
        self._cur_path = None

        self.add_mode = False
        self.add_input = ""
        self.add_cursor = 0

        self.q_follow = True   # auto-keep the active job visible
        self.q_scroll = 0      # manual view offset when not following

        self._init_colors()

    def _init_colors(self):
        if not curses.has_colors():
            return
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN,    -1)
        curses.init_pair(2, curses.COLOR_GREEN,   -1)
        curses.init_pair(3, curses.COLOR_YELLOW,  -1)
        curses.init_pair(4, curses.COLOR_RED,     -1)
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)
        curses.init_pair(6, curses.COLOR_WHITE,   -1)
        curses.init_pair(7, -1, curses.COLOR_CYAN)    # reverse: bg is cyan
        curses.init_pair(8, curses.COLOR_BLACK, curses.COLOR_CYAN)  # dim bar fill

    def _color(self, pair: int) -> int:
        return curses.color_pair(pair) if curses.has_colors() else 0

    def _bold(self, pair: int) -> int:
        return (curses.A_BOLD | curses.color_pair(pair)) if curses.has_colors() else curses.A_BOLD

    # ── Run loop ────────────────────────────────────────────────────

    def run(self):
        self.stdscr.nodelay(True)
        curses.curs_set(0)

        self._maybe_start_job()

        while not self.state.quit:
            try:
                self._handle_input()
                self._maybe_start_job()
                self._render()
                time.sleep(0.05)
            except KeyboardInterrupt:
                self.state.quit = True

        self._shutdown()

    # ── Job lifecycle ───────────────────────────────────────────────

    def _maybe_start_job(self):
        with self.state.lock:
            if self.state.quit or self.state.status == "paused":
                return
            slots = self.args.jobs - self.state.active
        if slots <= 0:
            return

        for job in self.queue.jobs:
            if job.status == "pending" and slots > 0:
                with self.state.lock:
                    if self.state.quit or self.state.status == "paused":
                        return
                    self.state.active += 1
                    self.state.status = "encoding"
                    job.status = "encoding"
                    job.cancel = False
                    job.start = time.time()
                    job.paused_accum = 0.0
                t = threading.Thread(
                    target=ffmpeg_worker,
                    args=(job, self.state, self.args.codec, self.args.preset,
                          self.args.quality, self.args.delete, self.args.vr),
                    daemon=True,
                )
                self.state.workers.append(t)
                t.start()
                slots -= 1

    def _shutdown(self):
        with self.state.lock:
            self.state.quit = True
            pids = list(self.state.ffmpeg_pids)
            workers = list(self.state.workers)

        for pid in pids:
            _kill_process(pid, signal.SIGTERM)
        for t in workers:
            t.join(timeout=2.0)

        with self.state.lock:
            pids = list(self.state.ffmpeg_pids)
        for pid in pids:
            _kill_process(pid, signal.SIGKILL)
        for t in workers:
            t.join(timeout=1.0)

    # ── Input ────────────────────────────────────────────────────────

    def _handle_input(self):
        key = self.stdscr.getch()
        if key == -1:
            return

        if self.add_mode:
            self._handle_add_key(key)
            return

        ch = key
        if ch == ord('p'):
            self._toggle_pause()
        elif ch == ord('r'):
            self._resume()
        elif ch == ord('a'):
            self.add_mode = True
            self.add_input = ""
            self.add_cursor = 0
            curses.curs_set(1)
        elif ch == ord('A'):
            added = self._scan_and_add()
            if added > 0:
                self._maybe_start_job()
        elif ch == ord('s'):
            self._skip()
        elif ch in (curses.KEY_UP, ord('k')):
            self._scroll_queue(-1)
        elif ch in (curses.KEY_DOWN, ord('j')):
            self._scroll_queue(1)
        elif ch == curses.KEY_PPAGE:
            self._scroll_queue(-self._queue_visible() // 2)
        elif ch == curses.KEY_NPAGE:
            self._scroll_queue(self._queue_visible() // 2)
        elif ch == curses.KEY_HOME:
            self.q_follow = False
            self.q_scroll = 0
        elif ch == curses.KEY_END:
            self.q_follow = False
            self.q_scroll = max(0, len(self.queue.jobs) - self._queue_visible())
        elif ch == ord('f'):
            self.q_follow = True
        elif ch == ord('q'):
            self.state.quit = True
        elif ch == 3:  # Ctrl+C
            self.state.quit = True

    def _pause(self):
        with self.state.lock:
            if self.state.status != "encoding":
                return
            for pid in self.state.ffmpeg_pids:
                os.kill(pid, signal.SIGSTOP)
            self.state.status = "paused"
            self.pause_start = time.time()

    def _resume(self):
        with self.state.lock:
            if self.state.status != "paused":
                return
            elapsed = time.time() - self.pause_start
            self.total_paused += elapsed
            self.pause_start = 0.0
            for job in self.queue.jobs:
                if job.status == "encoding":
                    job.paused_accum += elapsed
            for pid in self.state.ffmpeg_pids:
                os.kill(pid, signal.SIGCONT)
            self.state.status = "encoding"

    def _toggle_pause(self):
        if self.state.status == "paused":
            self._resume()
        else:
            self._pause()

    def _skip(self):
        with self.state.lock:
            if self.state.status not in ("encoding", "paused"):
                return
            for job in self.queue.jobs:
                if job.status in ("encoding", "paused"):
                    job.cancel = True
            if self.state.status == "paused":
                for pid in self.state.ffmpeg_pids:
                    os.kill(pid, signal.SIGCONT)
            for pid in self.state.ffmpeg_pids:
                _kill_process(pid, signal.SIGTERM)

    # ── Queue scrolling ─────────────────────────────────────────────

    def _queue_visible(self) -> int:
        max_y, _ = self.stdscr.getmaxyx()
        return max(1, max_y - 8)

    def _scroll_queue(self, delta: int):
        jobs = self.queue.jobs
        visible = self._queue_visible()
        total = len(jobs)
        if total <= visible:
            return
        if self.q_follow:
            current_i = next((i for i, j in enumerate(jobs)
                              if j.status in ("encoding", "paused")), 0)
            cur_start = max(0, min(current_i - visible // 2, total - visible))
        else:
            cur_start = self.q_scroll
        self.q_follow = False
        self.q_scroll = max(0, min(cur_start + delta, total - visible))

    # ── Add-file input ──────────────────────────────────────────────

    def _handle_add_key(self, key):
        if key in (27,):  # Escape
            self.add_mode = False
            curses.curs_set(0)
        elif key in (curses.KEY_ENTER, 10, 13):
            path = self.add_input.strip()
            if path:
                job = self.queue.add_file(path)
                if job is None:
                    self.add_input = f"[invalid: {path}]"
                else:
                    self.add_mode = False
                    curses.curs_set(0)
                    self._maybe_start_job()
            else:
                self.add_mode = False
                curses.curs_set(0)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if self.add_cursor > 0:
                self.add_input = (self.add_input[:self.add_cursor - 1] +
                                  self.add_input[self.add_cursor:])
                self.add_cursor -= 1
        elif key == curses.KEY_DC:
            if self.add_cursor < len(self.add_input):
                self.add_input = (self.add_input[:self.add_cursor] +
                                  self.add_input[self.add_cursor + 1:])
        elif key == curses.KEY_LEFT:
            if self.add_cursor > 0:
                self.add_cursor -= 1
        elif key == curses.KEY_RIGHT:
            if self.add_cursor < len(self.add_input):
                self.add_cursor += 1
        elif key == curses.KEY_HOME:
            self.add_cursor = 0
        elif key == curses.KEY_END:
            self.add_cursor = len(self.add_input)
        elif key == 21:  # Ctrl+U — clear line
            self.add_input = ""
            self.add_cursor = 0
        elif key == 23:  # Ctrl+W — delete word
            before = self.add_input[:self.add_cursor].rstrip()
            idx = before.rfind(" ") + 1 if " " in before else 0
            self.add_input = self.add_input[:idx] + self.add_input[self.add_cursor:]
            self.add_cursor = idx
        elif 32 <= key <= 126:
            ch = chr(key)
            self.add_input = (self.add_input[:self.add_cursor] + ch +
                              self.add_input[self.add_cursor:])
            self.add_cursor += 1

    def _scan_and_add(self):
        existing = {job.input_path for job in self.queue.jobs}
        files = collect_all(self.args.i)
        added = 0
        for f in files:
            if f not in existing:
                job = self.queue.add_file(f)
                if job:
                    added += 1
        return added

    # ═══════════════════════════════════════════════════════════════════
    # Render
    # ═══════════════════════════════════════════════════════════════════

    def _render(self):
        self.stdscr.erase()
        max_y, max_x = self.stdscr.getmaxyx()

        if max_y < 10 or max_x < 60:
            self._render_small(max_y, max_x)
            self.stdscr.refresh()
            return

        row = 0
        row = self._render_header(row, max_x)
        row += 1
        row = self._render_current_file(row, max_x)
        row += 1
        row = self._render_queue(row, max_y, max_x)

        # Bottom bar (needs 2 rows: separator + key bar)
        bottom_y = max_y - 2
        if row < bottom_y:
            self._render_bottom(bottom_y, max_x)

        self.stdscr.refresh()

    def _render_small(self, max_y, max_x):
        msg = "Terminal too small — need at least 60×10"
        y = max(0, max_y // 2)
        x = max(0, (max_x - len(msg)) // 2)
        try:
            self.stdscr.addstr(y, x, msg, self._bold(4))
        except curses.error:
            pass

    # ── Header ──────────────────────────────────────────────────────

    def _render_header(self, row: int, max_x: int) -> int:
        now = time.time()
        active_elapsed = now - self.start_time - self.total_paused
        if self.pause_start > 0:
            active_elapsed -= (now - self.pause_start)
        active_elapsed = max(0, int(active_elapsed))
        ts = f"{active_elapsed // 3600:02d}:{(active_elapsed % 3600) // 60:02d}:{active_elapsed % 60:02d}"

        pending_count = sum(1 for j in self.queue.jobs if j.status == "pending")

        left = f" ffmpeg-encode [{self.args.codec}{' vr' if self.args.vr else ''}] "
        right = f" Elapsed: {ts}  Queued: {pending_count} "

        # If right side would overflow, shorten left
        avail = max_x - len(right) - 2
        if len(left) > avail:
            left = left[:avail]

        try:
            self.stdscr.addstr(row, 1, "─" * (max_x - 2), self._color(6))
            self.stdscr.addstr(row, 0, left[:avail], self._bold(1))
            self.stdscr.addstr(row, max_x - len(right) - 1, right, self._bold(6))
        except curses.error:
            pass
        return row

    # ── Current file progress ───────────────────────────────────────

    def _render_current_file(self, row: int, max_x: int) -> int:
        with self.state.lock:
            status = self.state.status
            active_count = self.state.active
            total = len(self.queue.jobs)

        # Find the currently encoding/paused job
        current = None
        idx = 0
        for i, job in enumerate(self.queue.jobs):
            if job.status in ("encoding", "paused"):
                current = job
                idx = i + 1
                break

        now = time.time()
        if current:
            pct = current.progress
            fps = current.fps
            ous = current.ous
            active_elapsed = max(0, now - current.start - current.paused_accum)
            if status == "paused" and self.pause_start > 0:
                active_elapsed -= (now - self.pause_start)

            # Reset speed sampling when the displayed job changes.
            if current.input_path != self._cur_path:
                self._cur_path = current.input_path
                self._prev_ous = 0
                self._prev_active = 0.0
                self._smooth_speed = 0.0

            # Compute instantaneous encoding speed from deltas between progress
            # updates, smoothed with exponential moving average.  Using ous
            # (microsecond-precise) avoids the sawtooth that rounded pct causes.
            if ous != self._prev_ous and ous > 0 and self._prev_ous > 0:
                delta_content = (ous - self._prev_ous) / 1_000_000.0
                delta_active = active_elapsed - self._prev_active
                if delta_active > 0.1:
                    inst = delta_content / delta_active
                    if inst > 0:
                        alpha = 0.3
                        if self._smooth_speed <= 0:
                            self._smooth_speed = inst
                        else:
                            self._smooth_speed = alpha * inst + (1 - alpha) * self._smooth_speed

            if ous != self._prev_ous:
                self._prev_ous = ous
                self._prev_active = active_elapsed
        else:
            pct = 0
            fps = 0.0
            ous = 0
            active_elapsed = 0.0

        # File label
        if current:
            name = current.basename
            label = f" [{idx}/{total}] {name} "
            if active_count > 1:
                label += f"(+{active_count - 1} active) "
        elif self.queue.pending:
            pending = self.queue.pending[0]
            label = f" Next: {pending.basename} "
        else:
            label = " Queue empty "

        max_label = max_x - 2
        if len(label) > max_label:
            label = label[:max_label - 1] + "…"

        try:
            self.stdscr.addstr(row, 1, "─" * (max_x - 2), self._color(6))
            self.stdscr.addstr(row, 2, label, self._bold(5))
        except curses.error:
            pass
        row += 1

        # Progress bar
        bar_width = max_x - 4
        filled = int(bar_width * pct / 100) if pct >= 0 else 0
        filled = max(0, min(bar_width, filled))
        empty = bar_width - filled

        try:
            if filled > 0:
                self.stdscr.addstr(row, 2, _BAR_FILL * filled, self._bold(1))
            if empty > 0:
                self.stdscr.addstr(row, 2 + filled, _BAR_EMPTY * empty, self._color(6))
        except curses.error:
            pass
        row += 1

        # Stats line — our own speed (not ffmpeg's, which counts pause time).
        if status == "paused":
            label_str = f"  {pct:3d}%    PAUSED"
        elif status == "encoding":
            label_str = f"  {pct:3d}%"
            if fps > 0:
                label_str += f"    {fps:5.1f} fps"

            speed = self._smooth_speed
            content_sec = ous / 1_000_000.0
            if speed <= 0 and ous > 0 and active_elapsed > 1:
                # fallback average speed before smooth-sampling has enough data
                speed = content_sec / active_elapsed
            if speed > 0:
                label_str += f"    {speed:.1f}x"
                if current and current.duration > 0:
                    if content_sec <= 0:
                        content_sec = pct / 100.0 * current.duration
                    label_str += f"    ETA {fmt_duration((current.duration - content_sec) / speed)}"
            elif ous == 0 and current:
                label_str += "    starting…"
        elif status == "idle":
            label_str = "  idle"
        else:
            label_str = f"  {pct:3d}%"

        try:
            self.stdscr.addstr(row, 2, label_str, self._bold(6))
        except curses.error:
            pass
        return row

    # ── Queue ────────────────────────────────────────────────────────

    def _render_queue(self, row: int, max_y: int, max_x: int) -> int:
        row += 1
        try:
            self.stdscr.addstr(row, 1, "─" * (max_x - 2), self._color(6))
            self.stdscr.addstr(row, 2, " Queue ", self._bold(6))
        except curses.error:
            pass
        row += 1

        jobs = self.queue.jobs
        if not jobs:
            try:
                self.stdscr.addstr(row, 4, "(empty — press 'a' to add files)", self._color(6))
            except curses.error:
                pass
            return row + 1

        # fixed: header(1) + label(1) + bar(1) + stats(1) + gap(1) + qheader(1) = 6
        #        + bottom(2) = 8 fixed rows total
        fixed_rows = 8
        visible = max_y - fixed_rows
        if visible < 1:
            return row

        # Try to show all, or scroll
        total_jobs = len(jobs)
        if total_jobs <= visible:
            start = 0
            end = total_jobs
        elif self.q_follow:
            # Keep the currently encoding job visible
            current_i = next((i for i, j in enumerate(jobs)
                              if j.status in ("encoding", "paused")), 0)
            start = max(0, min(current_i - visible // 2, total_jobs - visible))
            end = start + visible
        else:
            # Manual scroll — keep the user's position, don't yank it around
            start = max(0, min(self.q_scroll, total_jobs - visible))
            end = start + visible

        for i in range(start, end):
            job = jobs[i]
            icon, color = self._job_icon(job)
            idx_str = f"{i + 1:>{len(str(total_jobs))}}"
            prefix = f" {icon} {idx_str}. "

            if job.status == "done":
                suffix = f"{human_bytes(job.input_size)} → {human_bytes(job.output_size)}"
            elif job.status in ("encoding", "paused"):
                suffix = "(encoding…)" if job.status == "encoding" else "(paused)"
            elif job.status == "failed":
                suffix = job.error[:20] if job.error else "FAILED"
            elif job.status == "skipped":
                suffix = "SKIPPED"
            elif job.status == "kept":
                suffix = "kept original (output larger)"
            else:
                suffix = human_bytes(job.input_size) if job.input_size else ""

            name = job.basename
            suffix_width = len(suffix) + 1 if suffix else 0
            name_max = max_x - 2 - len(prefix) - suffix_width
            if name_max < 4:
                name_max = 4
            if len(name) > name_max:
                name = name[:name_max - 1] + "…"

            spacer = max(1, max_x - 2 - len(prefix) - len(name) - len(suffix))
            line = prefix + name + " " * spacer + suffix

            try:
                self.stdscr.addstr(row, 2, line[:max_x - 2], color)
            except curses.error:
                pass
            row += 1

        return row

    def _job_icon(self, job: Job):
        if job.status == "done":
            return "✓", self._bold(2)
        elif job.status == "encoding":
            return "▶", self._bold(3)
        elif job.status == "paused":
            return "⏸", self._bold(3)
        elif job.status == "failed":
            return "✗", self._bold(4)
        elif job.status == "skipped":
            return "→", self._color(6)
        elif job.status == "kept":
            return "○", self._color(6)
        else:
            return "·", self._color(6)

    # ── Bottom bar ──────────────────────────────────────────────────

    def _render_bottom(self, row: int, max_x: int):
        """row = first of two rows available (separator row, then key/add row)"""
        try:
            self.stdscr.addstr(row, 0, "─" * max_x, self._color(6))
        except curses.error:
            pass

        if self.add_mode:
            prompt = " Add file: "
            self.stdscr.addstr(row + 1, 0, prompt, self._bold(1))

            input_x = len(prompt)
            field_w = max_x - input_x - 1
            if field_w < 10:
                field_w = 10

            visible = self.add_input
            if len(visible) > field_w:
                cursor_pos = self.add_cursor
                half = field_w // 2
                if cursor_pos < half:
                    visible = self.add_input[:field_w]
                elif cursor_pos > len(self.add_input) - half:
                    visible = self.add_input[-field_w:]
                else:
                    visible = self.add_input[cursor_pos - half:cursor_pos + field_w - half]

            self.stdscr.addstr(row + 1, input_x, visible.ljust(field_w)[:field_w],
                               self._bold(6))

            cursor_x = input_x + min(self.add_cursor, field_w - 1)
            self.stdscr.move(row + 1, cursor_x)
        else:
            keys = " [p]ause  [r]esume  [a]dd file  [A] re-scan  [s]kip  [q]uit "
            try:
                x = max(0, (max_x - len(keys)) // 2)
                self.stdscr.addstr(row + 1, x, keys, self._bold(1))
            except curses.error:
                pass

# ═══════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════

def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Batch VAAPI encoder (HEVC or AV1) with curses TUI.",
    )
    p.add_argument("-i", action="append", default=None, metavar="DIR",
                   help="Input directory (batch mode); repeat to encode "
                        f"multiple directories (default: {DEFAULT_INPUT_DIR})")
    p.add_argument("-o", default=DEFAULT_OUTPUT_DIR,
                   help="Output directory (batch mode)")
    p.add_argument("--input",
                   help="Single input file")
    p.add_argument("--output",
                   help="Single output file")
    p.add_argument("--codec", default=DEFAULT_CODEC, choices=sorted(CODECS),
                   help=f"Video codec (default: {DEFAULT_CODEC})")
    p.add_argument("-p", dest="preset", default=DEFAULT_PRESET,
                   choices=["speed", "balanced", "quality"],
                   help="Speed preset — only affects parallelism (default: balanced)")
    p.add_argument("-q", dest="quality", type=int, default=None,
                   help="Quality target — lower = better "
                        "(HEVC 0-51, AV1 0-255; default depends on --codec)")
    p.add_argument("-j", "--jobs", dest="jobs", type=int, default=1,
                   help="Number of files to encode in parallel (default: 1)")
    p.add_argument("-n", dest="dry_run", action="store_true",
                   help="Dry run: list files and exit")
    p.add_argument("-k", "--keep", dest="keep", action="store_true",
                   help="Keep both the original and the encoded file "
                        "(no deletion; default: delete the original only when "
                        "the encode is smaller)")
    p.add_argument("--vr", action="store_true",
                   help="VR mode: conservative quality default (HEVC -qp 30, "
                        "AV1 -global_quality 130) and fail any encode whose "
                        "output resolution differs from the source; never "
                        "downscales. Outputs are written under a VR/ "
                        "subdirectory of the output root. An explicit -q "
                        "still overrides the default.")
    return p.parse_args()

def main_curses(stdscr, queue: Queue, state: SharedState, args):
    tui = TUI(stdscr, queue, state, args)
    tui.run()

def main():
    args = parse_args()
    if not args.i:
        args.i = [DEFAULT_INPUT_DIR]
    args.delete = not args.keep  # delete is default; -k keeps both files
    if args.jobs < 1:
        print("Error: --jobs must be >= 1", file=sys.stderr)
        sys.exit(1)

    # Resolve the codec-dependent quality default and clamp to its valid range.
    # --vr only changes the default; an explicit -q always wins.
    cfg = CODECS[args.codec]
    if args.quality is None:
        args.quality = cfg["vr_quality"] if args.vr else cfg["default_quality"]
    args.quality = max(cfg["quality_min"], min(cfg["quality_max"], args.quality))

    # --vr keeps its outputs separate, under a VR/ subdirectory of the output
    # root (e.g. /mnt/shared/Handbraked/VR).  An explicit single-file
    # --output still wins over this.
    output_dir = os.path.join(args.o, VR_SUBDIR) if args.vr else args.o

    # ── Dry run ─────────────────────────────────────────────────────
    if args.dry_run:
        if args.input:
            files = [args.input]
        else:
            files = collect_all(args.i)
        print(f"Would encode {len(files)} file(s):")
        for f in files:
            print(f"  {f}")
        return

    # ── VAAPI check ─────────────────────────────────────────────────
    if not check_vaapi():
        print("Error: VAAPI hwaccel not available in ffmpeg.", file=sys.stderr)
        print("  Is libva-utils / intel-media-driver installed?", file=sys.stderr)
        sys.exit(1)

    queue = Queue(args.i, output_dir)

    # ── Single-file mode ────────────────────────────────────────────
    if args.input:
        job = queue.add_file(args.input)
        if job is None:
            print(f"Error: file not found — {args.input}", file=sys.stderr)
            sys.exit(1)
        if args.output:
            job.output_path = str(pathlib.Path(args.output).with_suffix(".mkv"))
    else:
        files = collect_all(args.i)
        if not files:
            print(f"No video files found in: {', '.join(args.i)}", file=sys.stderr)
            print(f"Searched extensions: {', '.join(EXTENSIONS)}", file=sys.stderr)
            print("Launching with empty queue — press 'a' to add files.", file=sys.stderr)
        for f in files:
            queue.add_file(f)

    state = SharedState()
    curses.wrapper(main_curses, queue, state, args)

    # ── Summary after TUI exit ──────────────────────────────────────
    done, failed, skipped, kept, total_in, total_out = queue.stats
    print()
    print("═" * 44)
    print(f" Done: {done}  |  Failed: {failed}  |  Skipped: {skipped}  |  Kept: {kept}")
    if done + failed + skipped + kept > 0:
        saved = total_in - total_out
        if saved >= 0:
            pct = saved / total_in * 100 if total_in else 0
            print(f" Saved: {human_bytes(saved)} ({pct:.1f}%)")
        else:
            print(f" Grew:   +{human_bytes(-saved)}")
        print(f" In:     {human_bytes(total_in)}")
        print(f" Out:    {human_bytes(total_out)}")
    print("═" * 44)

if __name__ == "__main__":
    main()
