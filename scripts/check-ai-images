#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: check-ai-images [-v] [DIRECTORY]

Inspect image files in subdirectories for AI-generation metadata using exiftool.
Reports which subdirectories contain images with AI-related metadata.

Options:
  -v        Verbose: show which file and pattern triggered each AI detection.
  -h        Show this help.

Default directory: current working directory.
Sample size: up to 3 images per subdirectory.
EOF
    exit 1
}

main() {
    local verbose=0
    local target="."

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v) verbose=1; shift ;;
            -h|--help) usage ;;
            -*) echo "Unknown option: $1" >&2; usage ;;
            *) target="$1"; shift ;;
        esac
    done

    if [[ ! -d "$target" ]]; then
        echo "Error: '$target' is not a directory" >&2
        exit 1
    fi

    local dirs_ai=()
    local dirs_clean=()
    local dirs_empty=()
    local total_dirs=0
    local sample_size=3

    while IFS= read -r -d '' dir; do
        total_dirs=$((total_dirs + 1))

        local images=()
        while IFS= read -r -d '' img; do
            images+=("$img")
        done < <(find "$dir" -maxdepth 1 -type f \( \
            -iname '*.jpg'  -o -iname '*.jpeg' -o -iname '*.png'   \
            -o -iname '*.webp' -o -iname '*.avif' -o -iname '*.heic' \
            -o -iname '*.heif' -o -iname '*.tiff' -o -iname '*.tif'  \
            -o -iname '*.bmp'  -o -iname '*.gif'  -o -iname '*.jxl'  \
        \) -print0 2>/dev/null | head -z -n "$sample_size")

        if [[ ${#images[@]} -eq 0 ]]; then
            dirs_empty+=("$dir")
            continue
        fi

        local found_ai=0
        local found_img=""
        local found_reason=""
        for img in "${images[@]}"; do
            local meta
            meta=$(exiftool -j "$img" 2>/dev/null | grep -vE '"SourceFile"|"Directory"|"FileName"' || true)
            if [[ -z "$meta" ]]; then
                continue
            fi

            local value_only
            value_only=$(echo "$meta" | sed -n 's/^[[:space:]]*"[^"]*"[[:space:]]*:[[:space:]]*//p')

            check_pattern() {
                local label="$1"; shift
                if echo "$value_only" | grep -qi "$@"; then
                    found_ai=1
                    found_img="$img"
                    found_reason="$label"
                    return 0
                fi
                return 1
            }

            check_pattern "Midjourney"              -e 'Midjourney'
            check_pattern "Stable Diffusion"        -e 'Stable Diffusion'
            check_pattern "DALL-E"                  -e 'DALL-E\|DALL·E'
            check_pattern "NovelAI"                 -e 'NovelAI'
            check_pattern "Leonardo AI"             -e 'Leonardo[. ]AI'
            check_pattern "Adobe Firefly"           -e 'Adobe Firefly'
            check_pattern "Bing Image Creator"      -e 'Bing Image Creator'
            check_pattern "ComfyUI"                 -e 'ComfyUI'
            check_pattern "Automatic1111"           -e 'Automatic1111'
            check_pattern "InvokeAI"                -e 'InvokeAI'
            check_pattern "CivitAI"                 -e 'CivitAI'
            check_pattern "DreamStudio"             -e 'DreamStudio'
            check_pattern "craiyon"                 -e 'craiyon'
            check_pattern "Artbreeder"              -e 'Artbreeder'
            check_pattern "Wombo"                   -e 'Wombo'
            check_pattern "DeepAI"                  -e 'DeepAI'
            check_pattern "NightCafe"               -e 'NightCafe'
            check_pattern "Playground AI"           -e 'Playground'
            check_pattern "Ideogram"                -e 'Ideogram'
            check_pattern "Flux"                    -e 'Flux'
            check_pattern "SDXL"                    -e 'SDXL'
            check_pattern "A1111"                   -e 'A1111'
            check_pattern "DiffusionBee"            -e 'DiffusionBee'
            check_pattern "Fooocus"                 -e 'Fooocus'
            check_pattern "RuDALL-E"                -e 'RuDALL-E'
            check_pattern "Kandinsky"               -e 'Kandinsky'
            check_pattern "SwarmUI"                 -e 'SwarmUI'
            check_pattern "tidybot"                 -e 'tidybot'
            check_pattern "StableSwarmUI"           -e 'StableSwarmUI'
            check_pattern "AI-generated tag"        -e 'AI[ -]?[Gg]enerated'
            check_pattern "generated by AI"         -e 'generated by AI\|generated with AI'
            check_pattern "synthetic"               -e 'synthetic'
            check_pattern "Promptrr"                -e 'Promptrr'
            check_pattern "PromptsPal"              -e 'PromptsPal'
            check_pattern "StylePrompt"             -e 'StylePrompt'
            check_pattern "AITag"                   -e '"AITag"'
            check_pattern "AIMetadata"              -e '"AIMetadata'
            check_pattern "AI_Generated"            -e '"AI[_-][Gg]enerated'

            if [[ $found_ai -eq 0 ]]; then
                local param_match=0
                echo "$value_only" | grep -qi -e '"Parameters"' -e '"parameters"' && param_match=1
                if [[ $param_match -eq 1 ]]; then
                    if echo "$value_only" | grep -qi 'negative prompt\|Negative prompt\|Steps:\|Sampler:\|CFG scale\|Seed:\|Model hash'; then
                        found_ai=1
                        found_img="$img"
                        found_reason="Stable Diffusion PNG Parameters"
                    fi
                fi
            fi

            [[ $found_ai -eq 1 ]] && break
        done

        if [[ $found_ai -eq 1 ]]; then
            dirs_ai+=("$dir")
            if [[ $verbose -eq 1 ]]; then
                echo "[AI] $dir" >&2
                echo "       file: $found_img" >&2
                echo "       match: $found_reason" >&2
                echo "" >&2
            fi
        else
            dirs_clean+=("$dir")
        fi
    done < <(find "$target" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)

    echo "============================================"
    echo " Scanned $total_dirs subdirectories in $target"
    echo "============================================"
    echo ""

    echo "AI metadata found in ${#dirs_ai[@]} directorie(s):"
    for d in "${dirs_ai[@]}"; do
        echo "  [AI] $d"
    done
    [[ ${#dirs_ai[@]} -eq 0 ]] && echo "  (none)"

    echo ""
    echo "No AI metadata in ${#dirs_clean[@]} directorie(s):"
    for d in "${dirs_clean[@]}"; do
        echo "  [--] $d"
    done
    [[ ${#dirs_clean[@]} -eq 0 ]] && echo "  (none)"

    if [[ ${#dirs_empty[@]} -gt 0 ]]; then
        echo ""
        echo "No images found in ${#dirs_empty[@]} directorie(s):"
        for d in "${dirs_empty[@]}"; do
            echo "  [??] $d"
        done
    fi
}

main "$@"
