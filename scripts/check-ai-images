#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: check-ai-images [-v] [-d] [-n COUNT] [DIRECTORY]

Inspect image files in subdirectories for AI-generation metadata using exiftool.
Reports which subdirectories contain images with AI-related metadata.

Options:
  -v        Verbose: show which file and pattern triggered each AI detection.
  -d        Debug: like -v, but for every matching sample, and print the
            matching metadata tags and values (key=value).
  -n COUNT  Number of images to sample per subdirectory (default 3).
            Use 0 to check every image.
  -h        Show this help.

Default directory: current working directory.
EOF
    exit 1
}

# label, regex (case-insensitive, applied to every tag name and value)
patterns_json() {
    cat <<'EOF'
[
  ["Midjourney","Midjourney"],
  ["Stable Diffusion","Stable Diffusion"],
  ["DALL-E","DALL-E|DALL·E"],
  ["NovelAI","NovelAI"],
  ["Leonardo AI","Leonardo[. ]AI"],
  ["Adobe Firefly","Adobe Firefly"],
  ["Bing Image Creator","Bing Image Creator"],
  ["ComfyUI","ComfyUI"],
  ["Automatic1111","Automatic1111"],
  ["InvokeAI","InvokeAI"],
  ["CivitAI","CivitAI"],
  ["DreamStudio","DreamStudio"],
  ["craiyon","craiyon"],
  ["Artbreeder","Artbreeder"],
  ["Wombo","Wombo"],
  ["DeepAI","DeepAI"],
  ["NightCafe","NightCafe"],
  ["Playground AI","Playground"],
  ["Ideogram","Ideogram"],
  ["Flux","Flux"],
  ["SDXL","SDXL"],
  ["A1111","A1111"],
  ["DiffusionBee","DiffusionBee"],
  ["Fooocus","Fooocus"],
  ["RuDALL-E","RuDALL-E"],
  ["Kandinsky","Kandinsky"],
  ["SwarmUI","SwarmUI"],
  ["tidybot","tidybot"],
  ["StableSwarmUI","StableSwarmUI"],
  ["AI-generated tag","AI[ -]?[Gg]enerated"],
  ["generated by AI","generated by AI|generated with AI"],
  ["synthetic","synthetic"],
  ["Promptrr","Promptrr"],
  ["PromptsPal","PromptsPal"],
  ["StylePrompt","StylePrompt"],
  ["AITag","AITag"],
  ["AIMetadata","AIMetadata"],
  ["AI_Generated","AI[_-][Gg]enerated"]
]
EOF
}

# Reads the JSON stream produced by exiftool and prints one record per flagged
# image: "file\0label\0matched tag=value pairs\0".
match_filter='
  def sd: "negative prompt|Steps:|Sampler:|CFG scale|Seed:|Model hash";
  def meta: del(.SourceFile, .Directory, .FileName) | to_entries;
  def firsthit($b):
    first($pats[] as $p | select($b | test($p[1]; "i")) | {l: $p[0], r: $p[1]})
    // (if ($b | test("Parameters"; "i")) and ($b | test(sd; "i"))
        then {l: "Stable Diffusion PNG Parameters", r: sd} else empty end);
  add // []
  | sort_by(.SourceFile)
  | .[]
  | . as $o
  | ($o | del(.SourceFile, .Directory, .FileName) | tojson) as $b
  | ($o | firsthit($b)) as $m
  | "\(.SourceFile)\u0000\($m.l)\u0000\(
      [ $o | meta[]
        | select((.key | test($m.r; "i")) or ((.value | tostring) | test($m.r; "i")))
        | "\(.key)=\((.value | tostring)[0:200])"
      ] | .[0:4] | join(" | ")
    )\u0000"
'

main() {
    local verbose=0
    local debug=0
    local sample_size=3
    local target="."

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v) verbose=1; shift ;;
            -d|--debug) debug=1; verbose=1; shift ;;
            -n|--number)
                if [[ $# -lt 2 ]]; then
                    echo "Error: $1 requires a count" >&2
                    usage
                fi
                if [[ ! "$2" =~ ^[0-9]+$ ]]; then
                    echo "Error: invalid sample size '$2' (expected a non-negative integer)" >&2
                    exit 1
                fi
                sample_size=$((10#$2))
                shift 2 ;;
            -n*) sample_size="${1#-n}"
                if [[ ! "$sample_size" =~ ^[0-9]+$ ]]; then
                    echo "Error: invalid sample size '${1#-n}' (expected a non-negative integer)" >&2
                    exit 1
                fi
                sample_size=$((10#$sample_size))
                shift ;;
            -h|--help) usage ;;
            -*) echo "Unknown option: $1" >&2; usage ;;
            *) target="$1"; shift ;;
        esac
    done

    local dep
    for dep in exiftool jq; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "Error: '$dep' not found in PATH" >&2
            exit 1
        fi
    done

    if [[ ! -d "$target" ]]; then
        echo "Error: '$target' is not a directory" >&2
        exit 1
    fi

    local -a dirs=()
    local -a files=()
    local -A seen=()
    local -A has_image=()
    local -A ai_reason=()   # dirs -> label
    local -A ai_file=()     # dirs -> matching file
    local -A ai_detail=()   # dirs -> matching tag=value pairs

    while IFS= read -r -d '' dir; do
        dirs+=("$dir")
    done < <(find "$target" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)

    # One find pass for the whole tree: keep at most $sample_size files per dir
    # (0 means keep every image).
    while IFS= read -r -d '' img; do
        local d="${img%/*}"
        local n=${seen[$d]:-0}
        if (( sample_size == 0 || n < sample_size )); then
            seen[$d]=$((n + 1))
            files+=("$img")
            has_image[$d]=1
        fi
    done < <(find "$target" -mindepth 2 -maxdepth 2 -type f \( \
        -iname '*.jpg'  -o -iname '*.jpeg' -o -iname '*.png'   \
        -o -iname '*.webp' -o -iname '*.avif' -o -iname '*.heic' \
        -o -iname '*.heif' -o -iname '*.tiff' -o -iname '*.tif'  \
        -o -iname '*.bmp'  -o -iname '*.gif'  -o -iname '*.jxl'  \
    \) -print0 2>/dev/null | sort -z)

    if (( ${#files[@]} > 0 )); then
        local pats
        pats=$(patterns_json)

        local tmpdir jobs
        tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/check-ai-images.XXXXXX")
        trap "rm -rf -- '$tmpdir'" EXIT

        jobs=$(nproc 2>/dev/null || echo 4)
        (( jobs > 8 )) && jobs=8
        (( jobs < 1 )) && jobs=1

        # Parallel, chunked exiftool. Each worker appends to its own slot file:
        # interleaving stdout from concurrent workers corrupts the JSON stream.
        printf '%s\0' "${files[@]}" \
            | xargs -0 -r -n 200 -P "$jobs" --process-slot-var=SLOT \
                sh -c 'exiftool -j -q -q -- "$@" >>"$0/$SLOT.json"' "$tmpdir" 2>/dev/null || true

        shopt -s nullglob
        local -a slot_files=("$tmpdir"/*.json)
        shopt -u nullglob

        if (( ${#slot_files[@]} > 0 )); then
            local f label detail
            while IFS= read -r -d '' f && IFS= read -r -d '' label && IFS= read -r -d '' detail; do
                local d="${f%/*}"
                if [[ -z "${ai_reason[$d]:-}" ]]; then
                    ai_reason[$d]="$label"
                    ai_file[$d]="$f"
                    ai_detail[$d]="$detail"
                fi
                if (( debug )); then
                    {
                        echo "[AI] $d"
                        echo "       file: $f"
                        echo "       match: $label"
                        echo "       tags: $detail"
                        echo ""
                    } >&2
                fi
            done < <(jq -j -s --argjson pats "$pats" "$match_filter" "${slot_files[@]}" 2>/dev/null || true)
        fi
    fi

    local dirs_ai=()
    local dirs_clean=()
    local dirs_empty=()

    for dir in "${dirs[@]}"; do
        if [[ -z "${has_image[$dir]:-}" ]]; then
            dirs_empty+=("$dir")
        elif [[ -n "${ai_reason[$dir]:-}" ]]; then
            dirs_ai+=("$dir")
        else
            dirs_clean+=("$dir")
        fi
    done

    if (( verbose )) && (( ! debug )) && (( ${#dirs_ai[@]} > 0 )); then
        for dir in "${dirs_ai[@]}"; do
            echo "[AI] $dir" >&2
            echo "       file: ${ai_file[$dir]}" >&2
            echo "       match: ${ai_reason[$dir]}" >&2
            if [[ -n "${ai_detail[$dir]:-}" ]]; then
                echo "       tags: ${ai_detail[$dir]}" >&2
            fi
            echo "" >&2
        done
    fi

    echo "============================================"
    echo " Scanned ${#dirs[@]} subdirectories in $target"
    echo " Checked ${#files[@]} image(s)"
    echo "============================================"
    echo ""

    echo "AI metadata found in ${#dirs_ai[@]} directorie(s):"
    for dir in "${dirs_ai[@]}"; do
        echo "  [AI] $dir"
    done
    if (( ${#dirs_ai[@]} == 0 )); then
        echo "  (none)"
    fi

    echo ""
    echo "No AI metadata in ${#dirs_clean[@]} directorie(s):"
    for dir in "${dirs_clean[@]}"; do
        echo "  [--] $dir"
    done
    if (( ${#dirs_clean[@]} == 0 )); then
        echo "  (none)"
    fi

    if (( ${#dirs_empty[@]} > 0 )); then
        echo ""
        echo "No images found in ${#dirs_empty[@]} directorie(s):"
        for dir in "${dirs_empty[@]}"; do
            echo "  [??] $dir"
        done
    fi
}

main "$@"
