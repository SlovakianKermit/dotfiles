# ---------------------------------------------------------------------------
# Never commit these — local backups, caches, and application state
# ---------------------------------------------------------------------------
*.bak
*.bak.*
*.bak-*
*.pyc
__pycache__/
*.asar
dotfiles/mpv/window-state.json

# ---------------------------------------------------------------------------
# Secrets: keys, salts, session tokens, credentials
# ---------------------------------------------------------------------------
configs/copyparty/cert.pem
configs/copyparty/*-salt.txt
configs/copyparty/iphash
configs/copyparty/sessions.db
configs/copyparty/sessions.db.lock
configs/kdeconnect/certificate.pem
configs/kdeconnect/privateKey.pem
configs/opencode/auth.json
configs/jellyfin-mpv-shim/cred.json
configs/gallery-dl/
dotfiles/home/ssh/

# ---------------------------------------------------------------------------
# Electron apps: only the small hand-editable config is synced
# ---------------------------------------------------------------------------
configs/brave/
configs/discord/
configs/legcord/
configs/vesktop/
configs/sunshine/
configs/BraveSoftware/

# Obsidian: obsidian.json (vault list) only — the rest is Electron state
configs/obsidian/*
!configs/obsidian/obsidian.json

# ---------------------------------------------------------------------------
# Large generated databases / caches
# ---------------------------------------------------------------------------
dotfiles/xnviewmp/Thumb.db
dotfiles/xnviewmp/*.db
dotfiles/qBittorrent/lockfile
# mandb index (regenerated by pull)
configs/man/index.db
