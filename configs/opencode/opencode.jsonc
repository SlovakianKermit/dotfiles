{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "plugin": [
    "opencode-pty",
    "@tarquinen/opencode-dcp",
    "opencode-supermemory@latest"
  ],
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        }
      }
    }
  },
  "agent": {
    "compaction": {
      "model": "deepseek/deepseek-flash"
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "external_directory": {
          "*": "allow"
        },
        "bash": {
          "*": "allow",
          "rm -rf *": "deny",
          "rm -fr *": "deny",
          "shutdown *": "deny",
          "reboot *": "deny",
          "poweroff *": "deny",
          "systemctl start *": "deny",
          "systemctl stop *": "deny",
          "systemctl restart *": "deny",
          "pacman -S *": "deny",
          "pacman -R *": "deny",
          "pacman -U *": "deny",
          "sudo *": "deny",
          "ssh * sudo *": "deny"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": {
      "*": "ask",
      "**/.local/bin/**": "allow",
      "tmp/**": "allow"
    },
    "external_directory": {
      "**/.local/bin/**": "allow",
      "**/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "*rm -rf*": "deny",
      "*rm -fr*": "deny",
      "*shred *": "deny",
      "*wipefs*": "deny",
      "*mkfs*": "deny",
      "*dd if=*": "deny",
      "*> /dev/sd*": "deny",
      "*shutdown*": "deny",
      "*reboot*": "deny",
      "*poweroff*": "deny"
    },
    "searxng": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [
    "~/.config/opencode/instructions.md",
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ]
}