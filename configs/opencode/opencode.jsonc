{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0",
    "opencode-supermemory@2.0.15"
  ],
  "providers": {
    "deepseek": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        }
      }
    }
  },
  "agents": {
    "compaction": {
      "model": "deepseek/deepseek-flash"
    },
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
        { "action": "shell", "resource": "shutdown *", "effect": "deny" },
        { "action": "shell", "resource": "reboot *", "effect": "deny" },
        { "action": "shell", "resource": "poweroff *", "effect": "deny" }
      ]
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "$HOME/.local/bin/*", "effect": "allow" },
    { "action": "edit", "resource": "$HOME/.local/share/man/*", "effect": "allow" },
    { "action": "external_directory", "resource": "$HOME/.local/bin/*", "effect": "allow" },
    { "action": "external_directory", "resource": "$HOME/.local/share/man/*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "*shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "*reboot*", "effect": "deny" },
    { "action": "shell", "resource": "*poweroff*", "effect": "deny" },
    { "action": "searxng", "resource": "*", "effect": "allow" }
  ],
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "instructions": [
    "~/.config/opencode/instructions.md",
    "~/.config/opencode/instructions/shell_strategy.md"
  ]
}
