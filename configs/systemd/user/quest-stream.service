[Unit]
Description=quest-stream - serve video folders to Meta Quest over USB (miniserve + adb reverse)
After=default.target

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/quest-stream
Restart=on-failure
RestartSec=5
MemoryMax=256M

[Install]
WantedBy=default.target
